{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weightspace Index records, contract version 1",
  "description": "One definition per file type. docs/structure.md maps each path pattern to its definition; schema/README.md lists the checks a schema cannot express.",
  "$defs": {
    "contractVersion": { "const": 1 },
    "text": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$(?![\\s\\S])" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])" },
    "sizeBytes": { "type": "integer", "minimum": 1 },
    "versionNumber": { "type": "integer", "minimum": 1 },
    "repoId": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*/[A-Za-z0-9_-][A-Za-z0-9_.-]*$(?![\\s\\S])" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$(?![\\s\\S])" },
    "relativePath": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$(?![\\s\\S])" },
    "fileName": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$(?![\\s\\S])" },
    "githubHandle": { "type": "string", "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9])*$(?![\\s\\S])" },
    "kind": { "enum": ["replacement", "lora"] },
    "versionStatus": { "enum": ["active", "deprecated", "withdrawn"] },
    "performedBy": { "enum": ["index", "author", "third-party"] },
    "fileFormat": { "enum": ["safetensors", "gguf", "json"] },

    "unknown": {
      "type": "object",
      "properties": {
        "state": { "const": "UNKNOWN" },
        "reason": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" }
      },
      "required": ["state", "reason", "owner"],
      "additionalProperties": false
    },

    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "index-path" },
            "path": { "$ref": "#/$defs/relativePath" }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "hf" },
            "repo_type": { "enum": ["model", "dataset"] },
            "repo_id": { "$ref": "#/$defs/repoId" },
            "revision": { "$ref": "#/$defs/revision" },
            "path": { "$ref": "#/$defs/relativePath" }
          },
          "required": ["kind", "repo_type", "repo_id", "revision", "path"],
          "additionalProperties": false
        }
      ]
    },

    "artifact": {
      "type": "object",
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "$ref": "#/$defs/sizeBytes" },
        "locators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/locator" } }
      },
      "required": ["sha256", "size_bytes", "locators"],
      "additionalProperties": false
    },

    "namedDigest": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["name", "sha256"],
      "additionalProperties": false
    },

    "baseFile": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "$ref": "#/$defs/sizeBytes" }
      },
      "required": ["path", "sha256", "size_bytes"],
      "additionalProperties": false
    },

    "profile": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": {
          "type": "object",
          "properties": {
            "repo_id": { "$ref": "#/$defs/repoId" },
            "revision": { "$ref": "#/$defs/revision" }
          },
          "required": ["repo_id", "revision"],
          "additionalProperties": false
        },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/baseFile" } }
      },
      "required": ["id", "source", "files"],
      "additionalProperties": false
    },

    "author": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "url": { "$ref": "#/$defs/text" }
      },
      "required": ["name"],
      "additionalProperties": false
    },

    "versionFile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": { "$ref": "#/$defs/fileName" },
            "role": { "const": "source" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size_bytes": { "$ref": "#/$defs/sizeBytes" },
            "locators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/locator" } }
          },
          "required": ["name", "role", "sha256", "size_bytes", "locators"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": { "$ref": "#/$defs/fileName" },
            "role": { "const": "derived" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size_bytes": { "$ref": "#/$defs/sizeBytes" },
            "locators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/locator" } },
            "derived_from": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } },
            "tool": {
              "type": "object",
              "properties": {
                "name": { "$ref": "#/$defs/text" },
                "version": { "$ref": "#/$defs/text" }
              },
              "required": ["name", "version"],
              "additionalProperties": false
            }
          },
          "required": ["name", "role", "sha256", "size_bytes", "locators", "derived_from", "tool"],
          "additionalProperties": false
        }
      ]
    },

    "score": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "metric": { "$ref": "#/$defs/text" },
            "value": { "type": "number" },
            "unit": { "$ref": "#/$defs/text" },
            "denominator": { "type": "integer", "minimum": 1 }
          },
          "required": ["metric", "value", "unit", "denominator"],
          "additionalProperties": false
        },
        { "$ref": "#/$defs/unknown" }
      ]
    },

    "base": {
      "description": "models/<namespace>/<model>/base.json",
      "type": "object",
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile" } }
      },
      "required": ["contract_version", "profiles"],
      "additionalProperties": false
    },

    "patch": {
      "description": "models/<namespace>/<model>/<patch-slug>/patch.json",
      "type": "object",
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "title": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "kind": { "$ref": "#/$defs/kind" },
        "authors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/author" } },
        "submitter": { "$ref": "#/$defs/githubHandle" },
        "license": { "$ref": "#/$defs/text" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "version": { "$ref": "#/$defs/versionNumber" },
              "status": { "$ref": "#/$defs/versionStatus" }
            },
            "required": ["version", "status"],
            "additionalProperties": false
          }
        }
      },
      "required": ["contract_version", "title", "summary", "kind", "authors", "submitter", "license", "tags", "versions"],
      "additionalProperties": false
    },

    "version": {
      "description": "models/<namespace>/<model>/<patch-slug>/v<N>/version.json",
      "type": "object",
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "changelog": { "$ref": "#/$defs/text" },
        "target_profile": { "$ref": "#/$defs/id" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/versionFile" } }
      },
      "required": ["contract_version", "changelog", "target_profile", "files"],
      "additionalProperties": false
    },

    "run": {
      "description": "models/<namespace>/<model>/runs/<run-id>/run.json or .../v<N>/runs/<run-id>/run.json",
      "type": "object",
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "profile": { "$ref": "#/$defs/id" },
        "performed_by": { "$ref": "#/$defs/performedBy" },
        "protocol": { "$ref": "#/$defs/namedDigest" },
        "dataset": { "$ref": "#/$defs/namedDigest" },
        "settings": { "type": "object" },
        "state": { "enum": ["COMPLETE", "INCOMPLETE"] },
        "score": { "$ref": "#/$defs/score" },
        "outcomes": { "$ref": "#/$defs/artifact" },
        "resources": { "$ref": "#/$defs/artifact" }
      },
      "required": ["contract_version", "profile", "performed_by", "protocol", "dataset", "settings", "state", "score", "outcomes"],
      "additionalProperties": false
    },

    "comparison": {
      "description": ".../v<N>/comparisons/<id>.json; baseline_run names a base run, patched_run a run of the same version",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract_version": { "$ref": "#/$defs/contractVersion" },
            "state": { "const": "MATCHED" },
            "baseline_run": { "$ref": "#/$defs/id" },
            "patched_run": { "$ref": "#/$defs/id" },
            "estimand": { "$ref": "#/$defs/text" },
            "denominator": { "type": "integer", "minimum": 1 },
            "matched_outcomes": { "$ref": "#/$defs/artifact" },
            "uncertainty": { "$ref": "#/$defs/text" }
          },
          "required": ["contract_version", "state", "baseline_run", "patched_run", "estimand", "denominator", "matched_outcomes", "uncertainty"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract_version": { "$ref": "#/$defs/contractVersion" },
            "state": { "const": "REFUSED" },
            "baseline_run": { "$ref": "#/$defs/id" },
            "patched_run": { "$ref": "#/$defs/id" },
            "estimand": { "$ref": "#/$defs/text" },
            "reason": { "$ref": "#/$defs/text" }
          },
          "required": ["contract_version", "state", "baseline_run", "patched_run", "estimand", "reason"],
          "additionalProperties": false
        }
      ]
    },

    "assessment": {
      "description": ".../v<N>/assessments/<id>.json; comparisons name comparisons of the same version",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract_version": { "$ref": "#/$defs/contractVersion" },
            "intended_use": { "$ref": "#/$defs/text" },
            "decision": { "const": "UNKNOWN" },
            "reason": { "$ref": "#/$defs/text" },
            "owner": { "$ref": "#/$defs/text" }
          },
          "required": ["contract_version", "intended_use", "decision", "reason", "owner"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract_version": { "$ref": "#/$defs/contractVersion" },
            "intended_use": { "$ref": "#/$defs/text" },
            "decision": { "enum": ["SUPPORTED", "REJECT", "INCONCLUSIVE"] },
            "policy": { "$ref": "#/$defs/artifact" },
            "comparisons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
            "reason": { "$ref": "#/$defs/text" }
          },
          "required": ["contract_version", "intended_use", "decision", "policy", "comparisons", "reason"],
          "additionalProperties": false
        }
      ]
    },

    "indexFile": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/fileName" },
        "role": { "enum": ["source", "derived"] },
        "format": { "$ref": "#/$defs/fileFormat" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "$ref": "#/$defs/sizeBytes" },
        "locators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/locator" } },
        "derived_from": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } }
      },
      "required": ["name", "role", "format", "sha256", "size_bytes", "locators"],
      "additionalProperties": false
    },

    "indexRun": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "profile": { "$ref": "#/$defs/id" },
        "performed_by": { "$ref": "#/$defs/performedBy" },
        "protocol": { "$ref": "#/$defs/namedDigest" },
        "state": { "enum": ["COMPLETE", "INCOMPLETE"] },
        "score": { "$ref": "#/$defs/score" }
      },
      "required": ["id", "profile", "performed_by", "protocol", "state", "score"],
      "additionalProperties": false
    },

    "indexAssessment": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "intended_use": { "$ref": "#/$defs/text" },
        "decision": { "enum": ["UNKNOWN", "SUPPORTED", "REJECT", "INCONCLUSIVE"] }
      },
      "required": ["id", "intended_use", "decision"],
      "additionalProperties": false
    },

    "index": {
      "description": "GENERATED models/<namespace>/<model>/index.json",
      "type": "object",
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "base": { "$ref": "#/$defs/repoId" },
        "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile" } },
        "baseline_runs": { "type": "array", "items": { "$ref": "#/$defs/indexRun" } },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": { "$ref": "#/$defs/slug" },
              "title": { "$ref": "#/$defs/text" },
              "summary": { "$ref": "#/$defs/text" },
              "kind": { "$ref": "#/$defs/kind" },
              "authors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/author" } },
              "submitter": { "$ref": "#/$defs/githubHandle" },
              "license": { "$ref": "#/$defs/text" },
              "tags": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
              "latest": { "$ref": "#/$defs/versionNumber" },
              "versions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "version": { "$ref": "#/$defs/versionNumber" },
                    "status": { "$ref": "#/$defs/versionStatus" },
                    "changelog": { "$ref": "#/$defs/text" },
                    "target_profile": { "$ref": "#/$defs/id" },
                    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/indexFile" } },
                    "runs": { "type": "array", "items": { "$ref": "#/$defs/indexRun" } },
                    "assessments": { "type": "array", "items": { "$ref": "#/$defs/indexAssessment" } }
                  },
                  "required": ["version", "status", "changelog", "target_profile", "files", "runs", "assessments"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["slug", "title", "summary", "kind", "authors", "submitter", "license", "tags", "versions"],
            "additionalProperties": false
          }
        }
      },
      "required": ["contract_version", "base", "profiles", "baseline_runs", "patches"],
      "additionalProperties": false
    },

    "bases": {
      "description": "GENERATED bases.json",
      "type": "object",
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "bases": { "type": "array", "items": { "$ref": "#/$defs/repoId" } }
      },
      "required": ["contract_version", "bases"],
      "additionalProperties": false
    },

    "digestLookup": {
      "description": "GENERATED by-digest/<aa>/<sha256>.json",
      "type": "object",
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "matches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "base": { "$ref": "#/$defs/repoId" },
              "profile": { "$ref": "#/$defs/id" }
            },
            "required": ["base", "profile"],
            "additionalProperties": false
          }
        }
      },
      "required": ["contract_version", "matches"],
      "additionalProperties": false
    },

    "repoLookup": {
      "description": "GENERATED by-repo/<namespace>/<repo>.json",
      "type": "object",
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "matches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "base": { "$ref": "#/$defs/repoId" },
              "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
            },
            "required": ["base", "profiles"],
            "additionalProperties": false
          }
        }
      },
      "required": ["contract_version", "matches"],
      "additionalProperties": false
    }
  }
}
