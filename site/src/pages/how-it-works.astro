---
// Patch vs LoRA explainer. Not tied to any one model: the drawings are
// illustrations and the calculator works for any matrix shape.
import Arrow from "../components/Arrow.astro";
import Page from "../layouts/Page.astro";
import PatchAnatomy from "../components/viz/PatchAnatomy.astro";
import StorageCalc from "../components/viz/StorageCalc.astro";
import { loadIndex } from "../lib/index.ts";
import { mostBenchmarked, editStats } from "../lib/insight.ts";
import { runtimeGuide } from "../lib/runtime.ts";
import { authorReport } from "../data/reports.ts";
const benchmarked = mostBenchmarked(loadIndex().bases);
const stats = editStats(benchmarked);
const shipped = benchmarked && stats ? {
  name: authorReport(benchmarked)?.name ?? benchmarked.patch.title,
  href: benchmarked.patch.url,
  loraDownload: runtimeGuide(benchmarked).download?.sizeBytes ?? null,
  loraUnpacked: stats.loraBytes,
  replacement: stats.replacementBytes,
} : undefined;
---
<Page title="How it works" nav="learn" description="What a weight patch is, and why the index ships every patch both as a direct replacement and as a LoRA adapter.">
  <section class="home-band"><div class="wrap">
    <PatchAnatomy />
  </div></section>

  <section class="home-band subtle"><div class="wrap">
    <div class="band-title"><h2>Which file is smaller depends on the matrix</h2></div>
    <StorageCalc shipped={shipped} />
  </div></section>

  <section class="home-band"><div class="wrap bench-cta">
    <h2>We benchmark every patch</h2>
    {benchmarked && <a class="btn primary" href={`${benchmarked.patch.url}#results`}>See the benchmarks <Arrow /></a>}
  </div></section>
</Page>
