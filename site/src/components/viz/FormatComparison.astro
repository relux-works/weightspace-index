---
import Heat from "./Heat.astro";
import Arrow from "../Arrow.astro";
import { href } from "../../lib/config.ts";

const side = 12;
const edited = [2, 7, 8];
const matrix = { rows: side, cols: side, seed: 3, edited };
---
<section class="home-band subtle" id="patch-vs-lora" aria-labelledby="format-heading">
  <div class="wrap comparison">
    <div class="format-copy">
      <h2 id="format-heading">Patch vs LoRA</h2>
      <dl>
        <dt>Direct replacement</dt>
        <dd>Apply the patch once with <code>weightspace</code>. Run the resulting model copy in your usual runtime.</dd>
        <dt>LoRA adapter</dt>
        <dd>Keep your base model and load the adapter alongside it in a compatible runtime.</dd>
      </dl>
      <a class="text-link" href={href("how-it-works/")}>Explore how the formats work <Arrow /></a>
    </div>
    <div class="format-diagram">
      <div class="equation" role="img" aria-label="Illustration of a base weight matrix and the edited matrix. Three columns change. Two low-rank factors represent the same change in this example.">
        <div class="term"><Heat {...matrix} kind="w" /><span>Base weights</span></div>
        <span class="operator">+</span>
        <div class="forms">
          <div class="term"><Heat {...matrix} kind="delta" /><span>Patch</span></div>
          <small class="or">or</small>
          <div class="term">
            <div class="factors"><Heat {...matrix} cols={edited.length} kind="b" /><span>×</span><Heat {...matrix} rows={edited.length} kind="a" /></div>
            <span>LoRA</span>
          </div>
        </div>
        <span class="operator">=</span>
        <div class="term"><Heat {...matrix} kind="patched" /><span>Edited weights</span></div>
      </div>
      <label class="pause-motion"><input type="checkbox" /> Pause animation</label>
    </div>
  </div>
</section>

<style>
  .comparison { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); align-items: center; gap: 2rem 4rem; }
  .format-copy { max-width: 43ch; }
  .format-copy h2 { font-size: clamp(1.65rem, 3vw, 2.2rem); }
  .format-copy dl { margin: 1.2rem 0; }
  .format-copy dt { font-weight: 650; }
  .format-copy dd { margin: .15rem 0 .9rem; color: var(--color-text-muted); }
  .equation { container-type: inline-size; display: flex; justify-content: center; align-items: center; gap: clamp(.35rem, 1.2vw, 1rem); --heat-w: var(--color-text-muted); }
  .term, .forms { display: grid; justify-items: center; align-items: center; }
  .term { gap: .45rem; }
  .term > span { font-size: clamp(.74rem, 2.5cqi, .92rem); font-weight: 550; }
  .forms { gap: .5rem; }
  .forms small, .operator { color: var(--color-text-muted); }
  .operator { font-size: clamp(1rem, 5cqi, 1.65rem); }
  .factors { display: flex; align-items: center; gap: .3rem; }
  .equation :global(.heat) { width: calc(var(--cols) * min(1.95cqi, 9px)); height: auto; outline: 1px solid var(--color-border-strong); }
  .pause-motion { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .forms > .or { display: none; }
    .forms > .term {
      grid-area: 1 / 1;
      animation: format-crossfade 7s ease-in-out infinite;
    }
    .forms > .term:last-child { animation-delay: -3.5s; }
    .operator { margin-bottom: 1.3rem; }
    .pause-motion {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: .4rem;
      min-height: 2.5rem;
      margin-top: .4rem;
      color: var(--color-text-muted);
      font-size: .8rem;
      cursor: pointer;
    }
    .pause-motion input { accent-color: var(--color-accent); }
    .format-diagram:has(input:checked) .forms > .term { animation-play-state: paused; }
  }

  @keyframes format-crossfade {
    0%, 40%, 100% { opacity: 1; }
    50%, 90% { opacity: 0; }
  }

  @media (max-width: 52rem) {
    .comparison { grid-template-columns: minmax(0, 1fr); }
    .format-diagram { width: min(100%, 32rem); justify-self: center; }
  }
</style>
