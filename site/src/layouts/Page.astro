---
// Page shell: three-zone header (product, navigation, pinned commit), bands in
// main, and a footer that carries the Relux Works lockup. See site/DESIGN.md.
import "@fontsource-variable/inter/opsz.css";
import "@fontsource-variable/inter-tight/index.css";
import "@fontsource/roboto-mono/400.css";
import "@fontsource/roboto-mono/500.css";
import "@fontsource/roboto-mono/600.css";
import "../styles/global.css";
import reluxLight from "../assets/brand/relux-lockup-horizontal.svg?raw";
import reluxDark from "../assets/brand/relux-lockup-horizontal-dark.svg?raw";
import reluxMono from "../assets/brand/relux-lockup-horizontal-one-color.svg?raw";
import symbolLight from "../assets/brand/relux-symbol.svg?raw";
import symbolDark from "../assets/brand/relux-symbol-dark.svg?raw";
import symbolMono from "../assets/brand/relux-symbol-one-color.svg?raw";
// GitHub mark from Primer Octicons (MIT, see ../assets/octicons/LICENSE), unchanged.
import githubMark from "../assets/octicons/mark-github-16.svg?raw";
import { loadIndex, href } from "../lib/index.ts";

interface Props {
  title: string;
  description?: string;
  nav?: "models" | "search" | "compare";
}
const { title, description, nav } = Astro.props;
const index = loadIndex();
const commitUrl = `https://github.com/${index.githubRepo}/tree/${index.commit}`;
const docTitle = title === "Weightspace Index" ? title : `${title} · Weightspace Index`;
// The approved artwork is inlined unchanged; only presentation attributes are
// added to the root element so theme and forced-colors rules can pick a variant.
const logo = (svg: string, variant: string) =>
  svg.replace("<svg ", `<svg class="relux-logo ${variant}" aria-hidden="true" focusable="false" `);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{index.example ? `[Example] ${docTitle}` : docTitle}</title>
    {description && <meta name="description" content={description} />}
    {index.example && <meta name="robots" content="noindex, nofollow" />}
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={href("favicon-light.svg")} type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={href("favicon-dark.svg")} type="image/svg+xml" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    {index.example && (
      <div class="banner banner-example">
        <div class="wrap"><span class="eyebrow">Example data</span><span>Synthetic records from docs/example: not real patches, files or results.</span></div>
      </div>
    )}
    {index.dirty.length > 0 && (
      <div class="banner banner-dirty">
        <div class="wrap">
          <span class="eyebrow">Development build</span>
          <span>{index.dirty.length} index file(s) differ from commit {index.short}. Download links point at the commit, not these files.</span>
        </div>
      </div>
    )}
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="product" href={href()}>
          <Fragment set:html={logo(symbolLight, "light")} />
          <Fragment set:html={logo(symbolDark, "dark")} />
          <Fragment set:html={logo(symbolMono, "mono")} />
          <span>Weightspace Index</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <a href={href()} aria-current={nav === "models" ? "page" : undefined}>Models</a>
          <a href={href("search/")} aria-current={nav === "search" ? "page" : undefined}>Search</a>
          <a href={href("compare/")} aria-current={nav === "compare" ? "page" : undefined}>Compare</a>
        </nav>
        <div class="site-header__actions">
          <a class="gh-link" href={commitUrl} target="_blank" rel="noopener noreferrer" aria-label={`View on GitHub at commit ${index.short} (opens in a new tab)`} title={`Every value and download on this site is from index commit ${index.commit}`}>
            <Fragment set:html={githubMark.replace("<svg ", `<svg class="gh-mark" aria-hidden="true" focusable="false" `)} /><span class="gh-label">View on GitHub</span>
          </a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div>
          <p class="product-line">Weightspace Index</p>
          <p>
            Built from <a href={commitUrl}><span class="mono">{index.githubRepo}@{index.short}</span></a>, record contract version 1.
          </p>
          <nav aria-label="Index documents">
            <a href={index.docsAt("docs/structure.md")}>How the index works</a>
            <a href={index.docsAt("DISCLAIMER.md")}>Disclaimer</a>
            <a href={`https://github.com/${index.githubRepo}`}>Source</a>
          </nav>
          <p class="safety">
            Patched models may behave unexpectedly or unsafely. Inclusion, redistribution and published results do not guarantee safety.
          </p>
          <p class="trademarks">
            GitHub and the GitHub logo are trademarks of GitHub, Inc. Model names belong to their respective owners. Their use here implies no endorsement.
          </p>
        </div>
        <div class="operator">
          <span class="eyebrow">A project of</span>
          <a class="relux" href="https://github.com/relux-works" aria-label="Relux Works">
            <Fragment set:html={logo(reluxLight, "light")} />
            <Fragment set:html={logo(reluxDark, "dark")} />
            <Fragment set:html={logo(reluxMono, "mono")} />
          </a>
        </div>
      </div>
    </footer>
    <script>
      // Copy buttons: data-copy holds the text, or data-copy-from names an element
      // whose text is copied. Only an attribute changes; .swap keeps the width.
      document.addEventListener("click", async (event) => {
        const button = (event.target as Element | null)?.closest<HTMLElement>("[data-copy],[data-copy-from]");
        if (!button) return;
        const from = button.dataset.copyFrom ? document.getElementById(button.dataset.copyFrom) : null;
        const text = from ? (from.textContent ?? "") : (button.dataset.copy ?? "");
        try {
          await navigator.clipboard.writeText(text);
          button.setAttribute("data-copied", "");
          setTimeout(() => button.removeAttribute("data-copied"), 1400);
        } catch {
          button.setAttribute("title", "Copy failed: select the text instead");
        }
      });
    </script>
  </body>
</html>
