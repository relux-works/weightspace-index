---
import Page from "../layouts/Page.astro";
import Head from "../components/Head.astro";
import { href, loadIndex } from "../lib/index.ts";
import { facetOptions, searchEntries } from "../lib/search.ts";

const index = loadIndex();
const facets = facetOptions(searchEntries(index));
const primary = facets.filter((f) => f.primary);
const more = facets.filter((f) => !f.primary);
---
<Page title="Search" nav="search" description="Find a patch version by model, patch or author, and see who measured it and what they found.">
  <Head>
    <h1>Patch versions</h1>
    <form id="search" class="search-form" role="search" data-src={href("search.json")}>
      <div class="search-bar">
        <input type="search" name="q" placeholder="Model, patch or author" aria-label="Search text" autocomplete="off" maxlength="200" />
        {primary.map((f) => (
          <label class="facet">
            <span class="visually-hidden">{f.label}</span>
            <span class="select">
              <select name={f.key}>
                <option value="">Any {f.label.toLowerCase()}</option>
                {f.options.map((o) => <option value={o.value}>{o.label} ({o.count})</option>)}
              </select>
            </span>
          </label>
        ))}
      </div>
      {more.length > 0 && (
        <details class="more-filters">
          <summary>More filters</summary>
          <div class="facet-grid">
            {more.map((f) => (
              <label class="facet">
                <span class="visually-hidden">{f.label}</span>
                <span class="select">
                  <select name={f.key}>
                    <option value="">Any {f.label.toLowerCase()}</option>
                    {f.options.map((o) => <option value={o.value}>{o.label} ({o.count})</option>)}
                  </select>
                </span>
              </label>
            ))}
          </div>
        </details>
      )}
      <div class="search-status">
        <span id="count" class="result-count" aria-live="polite"></span>
        <button type="reset" class="text-button" hidden>Clear all</button>
      </div>
    </form>
  </Head>

  <section class="band results-band">
    <div class="wrap">
      <h2 id="results-heading" class="visually-hidden">Results</h2>
      <noscript><p class="empty"><strong>Search needs JavaScript</strong> Browse from <a href={href()}>Models</a> instead.</p></noscript>
      <ul id="results" class="results" aria-labelledby="results-heading"></ul>
    </div>
  </section>

  <script>
    import { matchesAll, queryWords } from "../lib/filter.ts";
    type Entry = {
      url: string; base: string; profile: string; slug: string; title: string; summary: string; formats: string[];
      tags: string[]; license: string; authors: string[]; submitter: string; version: string; status: string;
      latest: boolean; benchmarks: string[]; evidence: string[]; terms: string; versionCount: number;
      results: { source: string; text: string; value?: string }[];
    };
    const form = document.getElementById("search") as HTMLFormElement;
    const list = document.getElementById("results") as HTMLUListElement;
    const count = document.getElementById("count") as HTMLElement;
    const clear = form.querySelector('button[type="reset"]') as HTMLButtonElement;
    const modelsHref = (document.querySelector(".product") as HTMLAnchorElement | null)?.href ?? "/";
    type Key = "base" | "profile" | "format" | "tag" | "license" | "status" | "benchmark" | "evidence";
    /** Only the facets the build rendered; a facet with one value has no select. */
    const selects = [...form.querySelectorAll("select")];
    const keys = selects.map((s) => s.name as Key);
    const moreFilters = form.querySelector("details.more-filters") as HTMLDetailsElement | null;
    const values = (e: Entry, k: Key): string[] =>
      k === "tag" ? e.tags : k === "benchmark" ? e.benchmarks : k === "evidence" ? e.evidence : k === "format" ? e.formats : [e[k] as string];
    /** Only a version that is no longer active carries a status note. */
    const statusNotes: Record<string, string> = { deprecated: "Deprecated", withdrawn: "Withdrawn" };
    let entries: Entry[] = [];
    let loaded = false;
    let announce = 0;

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    }
    /** One line per performer: who measured, what, and the result. */
    function evidence(e: Entry) {
      if (!e.results.length) return el("p", "result-none", "No benchmarks submitted");
      const dl = el("dl", "result-evidence");
      for (const r of e.results) {
        const row = el("div");
        const dd = el("dd", undefined, r.text);
        if (r.value) dd.append(document.createTextNode(" "), el("span", "result-value", r.value));
        row.append(el("dt", undefined, r.source), dd);
        dl.append(row);
      }
      return dl;
    }

    /** A dashed box with a heading, a sentence and optional actions, as the only row. */
    function notice(title: string, text: string, ...actions: HTMLElement[]) {
      const li = el("li", "empty-row");
      const box = el("div", "empty");
      box.append(el("strong", undefined, title), document.createTextNode(` ${text}`));
      if (actions.length) {
        const row = el("div", "empty-actions");
        row.append(...actions);
        box.append(row);
      }
      li.append(box);
      return li;
    }
    function button(text: string, onClick: () => void) {
      const b = el("button", "btn quiet", text);
      b.type = "button";
      b.addEventListener("click", onClick);
      return b;
    }
    /** The live count is announced once typing pauses, not on every keystroke. */
    function setCount(text: string) {
      clearTimeout(announce);
      announce = window.setTimeout(() => { count.textContent = text; }, 350);
    }

    function readUrl() {
      const p = new URLSearchParams(location.search);
      (form.elements.namedItem("q") as HTMLInputElement).value = p.get("q") ?? "";
      for (const k of keys) {
        const s = form.elements.namedItem(k) as HTMLSelectElement;
        const v = p.get(k) ?? "";
        s.value = [...s.options].some((o) => o.value === v) ? v : "";
      }
      if (moreFilters && [...moreFilters.querySelectorAll("select")].some((s) => s.value)) moreFilters.open = true;
    }
    function writeUrl() {
      const p = new URLSearchParams();
      const q = (form.elements.namedItem("q") as HTMLInputElement).value.trim().slice(0, 200);
      if (q) p.set("q", q);
      for (const k of keys) {
        const v = (form.elements.namedItem(k) as HTMLSelectElement).value;
        if (v) p.set(k, v);
      }
      const s = p.toString();
      history.replaceState(null, "", s ? `?${s}` : location.pathname);
    }

    function render() {
      if (!loaded) return;
      const q = (form.elements.namedItem("q") as HTMLInputElement).value.trim();
      const words = queryWords(q);
      const chosen = keys.map((k) => [k, (form.elements.namedItem(k) as HTMLSelectElement).value] as const).filter(([, v]) => v);
      clear.hidden = !q && !chosen.length;
      const hits = entries.filter((e) => chosen.every(([k, v]) => values(e, k).includes(v)) && matchesAll(e.terms, words));
      list.replaceChildren(
        ...hits.map((e) => {
          const li = el("li");
          const main = el("div");
          const h = el("h3");
          const a = el("a");
          a.href = e.url;
          a.append(document.createTextNode(`${e.title} `), el("span", "muted", e.latest && e.versionCount > 1 ? `${e.version} · latest` : e.version));
          h.append(a);
          const sub = el("div", "row small muted result-facts");
          sub.append(el("span", undefined, e.base), el("span", "tag", e.profile), el("span", undefined, `${e.formats.join(" + ")} · ${e.license}`), ...e.tags.map((t) => el("span", "tag", t)));
          main.append(h, el("p", undefined, e.summary), sub);
          const meta = el("div", "meta");
          const note = statusNotes[e.status];
          if (note) meta.append(el("span", `status-note ${e.status}`, note));
          meta.append(evidence(e));
          li.append(main, meta);
          return li;
        }),
      );
      setCount(`${hits.length} of ${entries.length} version${entries.length === 1 ? "" : "s"}`);
      if (!entries.length) {
        list.append(notice("No patch versions yet", "Nothing has been published to the index."));
      } else if (!hits.length) {
        const filters = chosen.map(([k]) => {
          const select = form.elements.namedItem(k) as HTMLSelectElement;
          const label = select.labels?.[0]?.querySelector("span")?.textContent ?? k;
          return `${label}: ${select.selectedOptions[0].text.replace(/ \(\d+\)$/, "")}`;
        });
        const what = q ? `“${q}”${filters.length ? ` with ${filters.join(", ")}` : ""}` : filters.join(", ");
        list.append(notice("No versions match", `Nothing matches ${what}.`, button("Clear all", () => form.reset())));
      }
    }

    function load() {
      list.setAttribute("aria-busy", "true");
      list.replaceChildren();
      count.textContent = "Loading versions…";
      fetch(form.dataset.src!)
        .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
        .then((d: { entries: Entry[] }) => { entries = d.entries; loaded = true; list.removeAttribute("aria-busy"); render(); })
        .catch(() => {
          list.removeAttribute("aria-busy");
          count.textContent = "Search didn’t load.";
          const models = el("a", "btn quiet", "Browse models");
          (models as HTMLAnchorElement).href = modelsHref;
          list.replaceChildren(notice("Search didn’t load", "The list of versions could not be fetched. Try again, or browse from Models.", button("Try again", load), models));
        });
    }

    form.addEventListener("input", () => { writeUrl(); render(); });
    form.addEventListener("submit", (ev) => ev.preventDefault());
    form.addEventListener("reset", () => setTimeout(() => { writeUrl(); render(); }));
    readUrl();
    load();
  </script>
</Page>
