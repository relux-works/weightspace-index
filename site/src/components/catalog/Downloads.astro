---
import type { Version } from "../../lib/types.ts";
import type { RuntimeGuide } from "../../lib/runtime.ts";
import { downloadUrl } from "../../lib/catalog.ts";
import { humanBytes } from "../../lib/format.ts";
interface Props { version: Version; guide: RuntimeGuide }
const { version: v, guide } = Astro.props;
const sources = v.patch.kind === "replacement" ? v.files.filter(f => f.role === "source") : [];
const adapter = guide.download;
---
<aside class="download-box" id="files" aria-label="Patch downloads">
  <div class="download-head"><h2>Download patch</h2><span>{v.label} · {v.profile.id.toUpperCase()}</span></div>
  {sources.map(f => <a class="download-choice" href={downloadUrl(f)} data-recipe="Weightspace" download={f.name}>
    <div><strong>Direct replacement</strong><small>{f.name} · {humanBytes(f.size_bytes)}</small></div><span aria-hidden="true">↓</span>
  </a>)}
  {adapter && <a class="download-choice" href={adapter.href} data-recipe={guide.tabs[0]?.name} download={adapter.name}>
    <div><strong>LoRA adapter</strong><small>{adapter.label} · {humanBytes(adapter.sizeBytes)}</small></div><span aria-hidden="true">↓</span>
  </a>}
  {!sources.length && !adapter && <a href="#records">View release files →</a>}
  <a class="download-help" href="#use">How to use this patch ↓</a>
</aside>
