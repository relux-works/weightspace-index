---
// A patch card's evidence: one small chart per benchmark with up to three rows,
// the unpatched base, what the patch authors Reported and what the index
// Measured on its own benchmark. The reported row is a solid red bar, the
// measured one a ghost of it (a faint fill inside a red outline); a score that
// got worse looks the same, and its sign says so. Each patched row's change is taken from its own
// source's base, printed beside it, and never ranked against the other source
// (rule 9); when the measured base differs from the one drawn, its own base
// shows as a tick on the row. When the sources state different inference
// settings (the authors' temperature against the run's), each row names its
// own values for just the settings that differ; a benchmark can carry several
// Measured rows, one per run, told apart the same way. Provisional rows show
// their coverage alongside the score. Benchmarks without a displayable score show progress below.
// `full` is the patch page's version: a line on what each word means, a key,
// the charts with every score printed and a status per benchmark, measured
// labels linked to their records, then the authors' study scope, pending
// progress, and run records.
import { getEntry, render } from "astro:content";
import Arrow from "../Arrow.astro";
import type { Version } from "../../lib/types.ts";
import { sourceLabels } from "../../lib/catalog.ts";
import { exists, fail } from "../../lib/files.ts";
import { NEW_TAB } from "../../lib/links.ts";
import BenchmarkLegend from "./BenchmarkLegend.astro";
import RunSummary from "./RunSummary.astro";
import { scoreAxis } from "../../lib/score-axis.ts";
import { results, pending, resultTitle, resultKey, resultNote, fmt, signed, gain, type Result } from "../../lib/insight.ts";
import { samplingDiff, settingParts, settingText, type SamplingKey } from "../../lib/sampling.ts";
interface Props { version: Version; full?: boolean }
const { version: v, full = false } = Astro.props;
const Head = full ? "h3" : "h4";
const claimUrls = new Set(v.claims.map(c => c.record.source.url));
const names = v.patch.authors.map(a => a.name);
const byline = names.length > 1 ? `${names.slice(0, -1).join(", ")} and ${names.at(-1)}` : names[0];
const scores = results(v, { includeProvisional: true });
const progress = pending(v);
const noteId = `${v.patch.base.address}/${v.patch.slug}/${v.label}`;
const prefix = v.dir.startsWith("docs/example/") ? "docs/example/" : "";
const notePath = `${prefix}bench/notes/${noteId}.md`;
const hasNote = exists(notePath);
const noteTitle = "Why the scores may differ";
const noteLink = hasNote ? { href: `${full ? "" : v.patch.url}#benchmark-notes`, label: noteTitle } : undefined;
const note = full && hasNote ? await getEntry("benchmarkNotes", noteId) : undefined;
if (full && hasNote && !note) fail(`Missing benchmark note: ${notePath}`);
const BenchmarkNote = note ? (await render(note)).Content : null;

const keys = [...new Set(scores.map(resultKey))];
const axes = new Map([...new Set(scores.map(r => r.unit))].map(unit =>
  [unit, scoreAxis(scores.filter(r => r.unit === unit).flatMap(r => [r.base, r.patched]), unit)] as const));

const blocks = keys.map(key => {
  const rows = scores.filter(r => resultKey(r) === key);
  const author = rows.find(r => r.source === "author");
  // Every run of the benchmark gets a row: a rerun under the authors' settings sits beside the index's own.
  const measured = rows.filter(r => r.source === "index");
  // The row that decides the status: the first final measurement, else the first provisional one.
  const indep = measured.find(r => !r.provisional) ?? measured[0];
  const lead = (author ?? indep)!;
  const settings = samplingDiff([author?.sampling, ...measured.map(r => r.sampling)]);
  return { lead, author, indep, measured, settings, axis: axes.get(lead.unit)!, note: [resultNote(lead), !lead.higherIsBetter && "lower is better"].filter(Boolean).join(" · ") };
});
type Block = typeof blocks[number];
/** A row's values for the settings that differ within its benchmark, e.g. "(t=0.6)". */
function setting(r: Result, keys: SamplingKey[]) {
  const parts = settingParts(r.sampling, keys);
  return parts.length ? { short: `(${parts.map(p => `${p.short}=${p.value}`).join(", ")})`, long: settingText(parts) } : undefined;
}
const provisionalRuns = new Set(blocks.flatMap(({ measured }) => measured.flatMap(r => r.provisional ? [r.href] : [])));
const waits = progress.filter(w => !provisionalRuns.has(w.href));

// On the patch page, only a final measurement can confirm a reported direction.
const sign = (r: Result) => Math.sign(gain(r));
function status(b: Block): { text: string; tone: string } | undefined {
  if (!b.indep || b.indep.provisional) return;
  if (b.author) return sign(b.indep) === sign(b.author)
    ? { text: "Confirmed", tone: "ok" } : { text: "Not reproduced", tone: "miss" };
  return sign(b.indep) > 0 ? { text: "Measured only", tone: "ok" } : { text: "No gain found", tone: "miss" };
}
const anySelf = blocks.some(b => b.author);
const anyIndep = blocks.some(b => b.indep);
const rerun = anyIndep || progress.length > 0;
const anyTick = blocks.some(b => b.measured.some(r => r.base !== b.lead.base));
---
<div class:list={["evidence", "triad", full ? "full" : "compact"]}>
  {full && blocks.length > 0 && <p class="tri-intro">Each benchmark shows the unpatched base, the patch authors' own figure (<strong>{sourceLabels.author}</strong>) and{rerun ? "" : ", once it is run,"} a run of the index's own benchmark (<strong>{sourceLabels.index}</strong>), filed with every request and reply. Anyone can file a measurement: the index team or any contributor.</p>}
  {full && blocks.length > 0 && <BenchmarkLegend reported={anySelf} measured={anyIndep} measuredBase={anyTick} noteLink={noteLink} />}
  {blocks.map(b => {
    const base = b.lead.base;
    const u = b.lead.unit;
    const st = full && status(b);
    const authorSetting = b.author && setting(b.author, b.settings);
    return <section class="tri">
      {!full && <BenchmarkLegend class="tri-pop" reported={!!b.author} measured={!!b.indep} measuredBase={b.measured.some(r => r.base !== base)} noteLink={noteLink} />}
      <Head class="tri-head">{resultTitle(b.lead)}{b.note && <small>{b.note}</small>}{st && <span class:list={["tri-status", st.tone]}>{st.text}</span>}</Head>
      <ul class="tri-rows">
        <li class:list={["tri-row", "base", { provisional: !!b.lead.provisional }]}>
          <span class="tri-label">Base</span>
          <span class="tri-track" aria-hidden="true"><i style={b.axis.bar(base)}></i></span>
          <span class="tri-val">{fmt(base, u)}</span>
          <span class="tri-sub"></span>
        </li>
        {/* A benchmark the authors didn't report has no Reported row. */}
        {b.author && <li class="tri-row self">
          <span class="tri-label">{sourceLabels.author}{authorSetting && <span class="visually-hidden">, {authorSetting.long}</span>}</span>
          <span class="tri-track" aria-hidden="true"><i style={b.axis.bar(b.author.patched)}></i></span>
          {full
            ? <><span class="tri-val">{fmt(b.author.patched, u)}</span><span class="tri-chg">{signed(b.author.patched - b.author.base, u)}</span></>
            : <span class="tri-val"><span class="visually-hidden">{fmt(b.author.patched, u)}, </span>{signed(b.author.patched - b.author.base, u)}</span>}
          {/* Every row keeps a line under it: the settings that differ on the left (screen readers hear
              them with the label), a provisional run's progress on the right. Empty rows keep it too,
              so all charts share one row rhythm. */}
          <span class="tri-sub">{authorSetting && <small class="tri-setting" aria-hidden="true" title={authorSetting.long}>{authorSetting.short}</small>}</span>
        </li>}
        {b.measured.map(m => { const t = setting(m, b.settings); return <li class:list={["tri-row", "indep", { provisional: !!m.provisional }]}>
          <span class="tri-label">{full && !claimUrls.has(m.href)
            ? <a href={m.href}>{sourceLabels.index}</a> : sourceLabels.index}{t && <span class="visually-hidden">, {t.long}</span>}</span>
          <span class="tri-track" aria-hidden="true">
            <i style={b.axis.bar(m.patched)}></i>
            {m.base !== base && <b class="tri-tick" style={`left:${b.axis.position(m.base)}%`} title={`Its own base: ${fmt(m.base, u)}`}></b>}
          </span>
          {full
            ? <><span class="tri-val">{fmt(m.patched, u)}</span><span class="tri-chg">{signed(m.patched - m.base, u)}{m.base !== base && <small>from {fmt(m.base, u)}</small>}</span></>
            : <span class="tri-val"><span class="visually-hidden">{fmt(m.patched, u)}, from its own base of {fmt(m.base, u)}, </span>{signed(m.patched - m.base, u)}</span>}
          <span class="tri-sub">
            {t && <small class="tri-setting" aria-hidden="true" title={t.long}>{t.short}</small>}
            {m.provisional && <small class="tri-provisional">Provisional · {m.provisional.filed} of {m.provisional.total}<span class="tri-prov-unit"> item–seed pairs filed</span></small>}
          </span>
        </li>; })}
      </ul>
    </section>;
  })}

  {!full && blocks.length > 0 && <BenchmarkLegend class="tri-key-touch" reported={anySelf} measured={anyIndep} measuredBase={anyTick} noteLink={noteLink} />}

  {!blocks.length && !waits.length && <p class="no-score">No measurements published yet.</p>}

  {full && v.claims.map(c => <p class="study-scope">{sourceLabels.author} by {byline}{c.record.affiliation && ` (${c.record.affiliation})`} in <a href={c.record.source.url} {...NEW_TAB}>{c.record.source.title} <Arrow dir="out" /></a>. {c.record.conditions}</p>)}

  {waits.length > 0 && <div class="pending-deck" data-deck>
    {waits.length > 1 && <button type="button" class="deck-step" data-step="-1" aria-label="Previous pending benchmark" hidden><Arrow dir="left" chevron /></button>}
    <div class="pending-items" aria-live={waits.length > 1 ? "polite" : undefined} aria-atomic="true">
      {waits.map(w => <div class="coverage" data-plate>
        <p>{w.benchmark} · <strong>Benchmark pending</strong></p>
        <progress aria-label={`${w.benchmark} benchmark coverage`} value={w.filed} max={w.total} />
        <small>{w.filed} of {w.total} item–seed pairs filed</small>
      </div>)}
    </div>
    {waits.length > 1 && <button type="button" class="deck-step" data-step="1" aria-label="Next pending benchmark" hidden><Arrow chevron /></button>}
  </div>}

  {BenchmarkNote && <details class="fold benchmark-notes" id="benchmark-notes" open>
    <summary>{noteTitle}</summary>
    <article class="prose"><BenchmarkNote /></article>
  </details>}
  {full && v.runs.length > 0 && <details class="fold"><summary>Run records ({v.runs.length})</summary>{v.runs.map(r => <RunSummary version={v} run={r} />)}</details>}
</div>
<script>
  // Without JavaScript every plate stays visible; with it, one shows at a time.
  for (const deck of document.querySelectorAll<HTMLElement>("[data-deck]")) {
    const [prev, next] = deck.querySelectorAll<HTMLButtonElement>("[data-step]");
    if (!prev || !next) continue;
    const plates = [...deck.querySelectorAll<HTMLElement>("[data-plate]")];
    let at = 0;
    const show = () => {
      plates.forEach((p, i) => p.hidden = i !== at);
      prev.hidden = at === 0;
      next.hidden = at === plates.length - 1;
    };
    for (const b of [prev, next]) b.addEventListener("click", () => {
      at = Math.min(Math.max(at + Number(b.dataset.step), 0), plates.length - 1);
      show();
      (at === 0 ? next : at === plates.length - 1 ? prev : b).focus();
    });
    deck.dataset.nav = "";
    show();
  }
</script>
