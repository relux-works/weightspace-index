---
// Joint studies as a patch × patch matrix (model page) or as the list of
// studies that include one release (patch page). Each study shows the measured
// base, each member alone and all members together, from one measuring source.
import type { Base, Version } from "../../lib/types.ts";
import { loadIndex } from "../../lib/index.ts";
import { scoreAxis } from "../../lib/score-axis.ts";
import { pairKey, pairStudies } from "../../lib/combinations.ts";
import { activeVersion, sourceLabels } from "../../lib/catalog.ts";
import { authorReport } from "../../data/reports.ts";
import { combos, signed, fmt, VERDICT_LABEL } from "../../lib/insight.ts";
interface Props { base: Base; version?: Version }
const { base, version } = Astro.props;
const index = loadIndex();
const studies = combos(base, version);
const nameOf = (v: Version) => authorReport(v)?.name ?? v.patch.title;
const patches = base.patches.filter(p => activeVersion(p));
const byPair = pairStudies(studies);
const showMatrix = !version && patches.length > 2 && byPair.size > 0;
const testedPartners = new Set(studies.flatMap(s => s.members.map(m => m.release)));
const untested = version ? patches.filter(p => p !== version.patch && !testedPartners.has(activeVersion(p)!)) : [];
const id = (i: number) => `combo-${i}`;
const shownKinds = new Set([...byPair.values()].filter(hits => hits.length === 1).map(hits => studies[hits[0]].verdict) as string[]);
if (byPair.size < patches.length * (patches.length - 1) / 2) shownKinds.add("untested");
const legend = [
  { kind: "amplify", text: "Amplify: better than either alone" },
  { kind: "neutral", text: "No extra gain" },
  { kind: "interfere", text: "Interfere: worse than the best alone" },
  { kind: "untested", text: "Not tested yet" },
];
---
<div class="combos" data-combos>
  {!studies.length && <p class="quiet-row">{patches.length === 1
    ? "Only one active patch for this model. No combinations tested for this release."
    : "No combination studies published for these releases."}</p>}
  {studies.length > 0 && <div class:list={["combo-layout", { single: !showMatrix }]}>
    {showMatrix && <div class="combo-matrix-wrap">
      <table class="combo-matrix" style={`--n:${patches.length}`}>
        <caption class="visually-hidden">Patch pairs and how they behave together</caption>
        <thead><tr><td></td>{patches.slice(0, -1).map(p => <th scope="col"><span>{nameOf(activeVersion(p)!)}</span></th>)}</tr></thead>
        <tbody>
          {patches.slice(1).map((row, r) => <tr>
            <th scope="row">{nameOf(activeVersion(row)!)}</th>
            {patches.slice(0, -1).map((col, c) => {
              if (c > r) return <td class="void"></td>;
              const hits = byPair.get(pairKey(row.slug, col.slug));
              if (!hits) return <td><span class="cell untested"><small>Untested</small></span></td>;
              const study = studies[hits[0]];
              const target = hits.map(id).join(" ");
              const label = hits.length > 1 ? `${hits.length} studies` : VERDICT_LABEL[study.verdict];
              return <td><button type="button" class:list={["cell", hits.length === 1 ? study.verdict : "neutral"]} data-show={target} aria-controls={target}
                aria-label={`${nameOf(activeVersion(row)!)} with ${nameOf(activeVersion(col)!)}. ${label}`}>
                {hits.length === 1 && <b>{signed(study.together - study.best, study.unit)}</b>}<small>{label}</small></button></td>;
            })}
          </tr>)}
        </tbody>
      </table>
      <ul class="combo-legend">{legend.filter(l => shownKinds.has(l.kind)).map(l => <li class={l.kind}>{l.text}</li>)}</ul>
    </div>}
    <div class="combo-details">
      {studies.map((s, i) => {
        const rows = [
          { label: "Unpatched base", value: s.baseline, kind: "base" },
          ...s.members.map(m => ({ label: `${nameOf(m.release)} ${m.release.label} alone`, value: m.alone, kind: "alone", href: m.release.isLatest ? m.release.patch.url : m.release.url })),
          { label: "Together", value: s.together, kind: "joint" },
        ];
        const axis = scoreAxis(rows.map(r => r.value), s.unit);
        const best = s.best;
        return <article class="combo-card" id={id(i)} data-combo>
          <div class="combo-head">
            <div><p class="studymeta"><span class:list={["src-chip", s.measured_by === "author" ? "self" : "indep"]}>{sourceLabels[s.measured_by]}</span> · {s.benchmark} · {s.metric} · {s.denominator} items</p>
              <h3>{s.members.map((m, k) => <>{k > 0 && <span class="plus"> + </span>}{nameOf(m.release)} {m.release.label}</>)}</h3></div>
            <span class:list={["verdict", s.verdict]}>{VERDICT_LABEL[s.verdict]}</span>
          </div>
          <div class="combo-bars" style={`--best:${axis.position(best)}%`}>
            {rows.map(r => <div class:list={["cb-row", r.kind, s.verdict]}>
              <span class="cb-label">{r.href ? <a href={r.href}>{r.label}</a> : r.label}</span>
              <span class="cb-track"><i style={axis.bar(r.value)}></i></span>
              <span class="cb-val">{fmt(r.value, s.unit)}</span>
            </div>)}
          </div>
          <p class="combo-reading"><strong>{s.outcome}</strong> · together {fmt(s.together, s.unit)} vs best single {fmt(best, s.unit)} ({signed(s.together - best, s.unit)})</p>
          <details class="fold"><summary>How this was measured</summary><p>{s.protocol}</p>
            <ul>{s.members.map(m => <li>{m.artifact.name} · scale {m.scale}</li>)}</ul><a href={index.docsAt(s.file)}>Measurement record</a></details>
        </article>;
      })}
    </div>
  </div>}
  {untested.length > 0 && <p class="untested-list">No joint test with  {untested.map((p, i) => <>{i > 0 && ", "}<a href={p.url}>{nameOf(activeVersion(p)!)}</a></>)}</p>}
</div>
<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-combos]")) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-show]")];
    const cards = [...root.querySelectorAll<HTMLElement>("[data-combo]")];
    if (!buttons.length) continue;
    const linked = new Set(buttons.flatMap(b => b.dataset.show!.split(" ")));
    const show = (id: string) => {
      const selected = id.split(" ");
      cards.forEach(c => { c.hidden = linked.has(c.id) && !selected.includes(c.id); });
      buttons.forEach(b => b.setAttribute("aria-pressed", String(b.dataset.show === id)));
    };
    buttons.forEach(b => b.addEventListener("click", () => show(b.dataset.show!)));
    show(buttons[0].dataset.show!);
  }
</script>
