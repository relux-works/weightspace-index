---
import Arrow from "../components/Arrow.astro";
import Page from "../layouts/Page.astro";
import ModelCard from "../components/catalog/ModelCard.astro";
import Filter from "../components/catalog/Filter.astro";
import FormatComparison from "../components/viz/FormatComparison.astro";
import ShellCommand from "../components/ShellCommand.astro";
import { activeVersion } from "../lib/catalog.ts";
import { href, loadIndex } from "../lib/index.ts";
import { plural } from "../lib/format.ts";

const index = loadIndex();
// Put the richest base models first (most active patches, then alphabetical).
const models = [...index.bases].sort((a, b) => {
  const ca = a.patches.filter(p => activeVersion(p)).length;
  const cb = b.patches.filter(p => activeVersion(p)).length;
  return cb - ca || a.address.localeCompare(b.address);
});
const totalPatches = models.reduce((n, b) => n + b.patches.filter(p => activeVersion(p)).length, 0);

const registryExample = {
  text: [
    "# Add any Git-hosted index (GitHub, private GitLab, Gitea, or local mirror)",
    "wsp registry add internal ssh://git@gitlab.internal/ml/weightspace-index.git",
    "wsp registry pin internal v2026.11",
    "",
    "# Or browse & apply patches interactively in your terminal",
    "wsp",
  ].join("\n"),
  source: { path: "AGENTS.md", label: "AGENTS.md" },
};
---
<Page title="Weightspace Index" nav="models" description="Download a base model once and apply verified weight patches or native LoRA adapters — with before/after benchmarks, pinned SHA-256 digests, and one-command wsp launch.">
  <div class="wrap home-hero">
    <header class="find-intro">
      <h1>Download the base once. <br />Patch it for every job.</h1>
      <p>
        Verified bit&#8209;exact weight patches and native LoRA adapters for open models&nbsp;— swap 75–600&nbsp;MB adapters for coding agents and reasoning instead of re&#8209;downloading 50&nbsp;GB fine&#8209;tunes.
      </p>
      <div class="hero-actions">
        <div class="hero-buttons">
          <a class="btn primary" href="#models">Browse {plural(totalPatches, "patch", "patches")} <Arrow dir="down" /></a>
          <a class="btn" href={href("submit/")}>Add model or patch</a>
        </div>
        <div class="hero-links">
          <a class="text-link" href={href("how-it-works/")}>Why patches?</a>
          <a class="text-link" href={href("agent.md")}>For AI agents</a>
        </div>
      </div>
    </header>

    <ul class="value-strip" aria-label="What Weightspace Index gives you">
      <li>
        <strong>10× less disk &amp; bandwidth</strong>
        <p>Keep one 27B/24B base and attach small LoRAs or sparse bit&#8209;exact edits per harness.</p>
      </li>
      <li>
        <strong>Receipts, not hype</strong>
        <p>Every file pinned by 40&#8209;char revision &amp; SHA&#8209;256; author <em>Reported</em> claims stay separate from <em>Measured</em> runs.</p>
      </li>
      <li>
        <strong>Any Git registry, zero login</strong>
        <p>Use the default index, internal GitLab repos, or community indexes via <code>wsp</code>.</p>
      </li>
    </ul>

    <section class="directory" id="models" aria-labelledby="directory-heading">
      <div class="directory-label">
        <div>
          <h2 id="directory-heading">Choose a base model</h2>
          <span class="dir-count">{plural(models.length, "model")} · {plural(totalPatches, "active patch", "active patches")}</span>
        </div>
        <a class="btn" href={href("submit/")}>+ Add model / patch</a>
      </div>
      {models.length > 0 && <Filter target="model-list" label="Filter by model, harness, tag, or author (e.g. 27B, pi, opencode, SWE)" noun="models" one="model" searchHref={href("search/")} />}
      <p class="filter-status" role="status" id="model-list-status"></p>
      <ul class="model-list" id="model-list">{models.map(base => <ModelCard base={base} />)}</ul>
      {!models.length && <p class="quiet-row">No models have been published yet.</p>}
    </section>
  </div>

  <FormatComparison />

  <section class="home-band" id="registries" aria-labelledby="registries-heading">
    <div class="wrap registry-band">
      <div class="registry-copy">
        <h2 id="registries-heading">Use custom &amp; private Git registries</h2>
        <p>
          An index is just a Git repository with contract-v1 JSON files — no GitHub lock-in and no API account required.
          Connect internal GitLab mirrors, pin a specific commit or tag for reproducible deployments, or add third-party community registries (including separate indexes for abliterated patches).
        </p>
        <div class="registry-links">
          <a class="text-link" href={href("submit/")}>Publish to an index <Arrow /></a>
          <a class="text-link" href={href("agent.md")}>Read agent.md <Arrow /></a>
        </div>
      </div>
      <ShellCommand command={registryExample} title="Multi-registry setup with wsp" />
    </div>
  </section>
</Page>

<style>
  .home-hero {
    padding-block: clamp(var(--space-6), 4vw, var(--space-12)) clamp(var(--space-8), 4.5vw, var(--space-16));
  }
  .home-hero .find-intro h1 {
    font-size: clamp(1.85rem, 4.6vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: none;
  }
  .home-hero .find-intro p {
    margin-top: var(--space-4);
    max-width: 56ch;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.55;
  }
  .hero-actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
  }
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .hero-buttons .btn {
    min-height: 2.5rem;
    padding-inline: var(--space-4);
    font-size: 0.9375rem;
  }
  .hero-buttons .btn.primary :global(.arrow) {
    transition: transform var(--motion-fast) var(--motion-ease);
  }
  .hero-buttons .btn.primary:hover :global(.arrow) {
    transform: translateY(2px);
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-6);
  }
  .hero-links .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: var(--space-1);
    margin-inline: calc(var(--space-1) * -1);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
  }
  .hero-links .text-link:hover {
    text-decoration-color: currentColor;
  }
  .value-strip {
    --strip-gap: var(--space-8);
    list-style: none;
    padding: var(--space-6) 0;
    margin: var(--space-8) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4) var(--strip-gap);
    border-block: 1px solid var(--color-divider);
  }
  .value-strip li {
    position: relative;
    min-width: 0;
  }
  .value-strip li + li::before {
    content: "";
    position: absolute;
    inset-block: 0.1rem;
    inset-inline-start: calc(var(--strip-gap) / -2);
    width: 1px;
    background: var(--color-divider);
  }
  .value-strip strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }
  .value-strip p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  .value-strip em {
    font-style: normal;
    font-weight: 550;
    color: var(--color-text);
  }
  .value-strip code {
    color: var(--color-text);
    font-size: 0.84em;
    padding: 0.08em 0.35em;
    border-radius: var(--radius-control);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-divider);
  }
  .home-hero .directory { margin-top: var(--space-12); padding: 0; border: 0; }
  .dir-count { display: block; color: var(--color-text-muted); font-size: .84rem; margin-top: .15rem; }
  :global(.model-entry__right) { display: inline-flex; align-items: center; gap: .85rem; flex-shrink: 0; }
  :global(.model-entry__gain) {
    font: 600 .8rem/1 var(--font-mono); color: var(--color-accent);
    padding: .3rem .55rem; border-radius: .25rem; background: var(--color-surface-subtle);
    white-space: nowrap;
  }
  .registry-band { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 1.5rem 3rem; align-items: center; }
  .registry-copy h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .registry-copy p { margin-top: .7rem; color: var(--color-text-muted); max-width: 52ch; }
  .registry-links { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 1.25rem; }
  @media (pointer: coarse) {
    .hero-buttons .btn,
    .hero-links .text-link {
      min-height: 2.75rem;
    }
  }
  @media (max-width: 60rem) {
    .value-strip { --strip-gap: var(--space-6); }
  }
  @media (max-width: 52rem) {
    .registry-band { grid-template-columns: minmax(0, 1fr); }
    :global(.model-entry__gain) { display: none; }
  }
  @media (max-width: 44rem) {
    .value-strip {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding-block: var(--space-4);
      margin-top: var(--space-6);
    }
    .value-strip li + li::before { display: none; }
    .value-strip li + li {
      border-top: 1px solid var(--color-divider);
      padding-top: var(--space-3);
    }
    .home-hero .directory { margin-top: var(--space-8); }
  }
  @media (max-width: 30rem) {
    .hero-actions { gap: var(--space-2) var(--space-4); }
    .hero-buttons { gap: var(--space-2); }
    .hero-buttons .btn { font-size: 0.875rem; padding-inline: 0.6875rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-buttons .btn.primary:hover :global(.arrow) { transform: none; }
  }
</style>
