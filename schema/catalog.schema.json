{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weightspace Index scaffold record contract",
  "description": "Structural contract only. Application version 1 separates discovery, identities, observations, analyses and scoped policy decisions. No populated evidence records or supported entries are shipped. TEMPLATE is never an admissible live catalog. See README.md in this directory.",
  "oneOf": [
    {
      "properties": {
        "document_kind": {
          "const": "catalog"
        },
        "entries": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "document_kind": {
          "const": "catalog"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "minItems": 1
        },
        "profiles": {
          "type": "array",
          "minItems": 1
        },
        "treatments": {
          "type": "array",
          "minItems": 1
        },
        "assessments": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "document_kind": {
          "const": "TEMPLATE"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/templateEntry"
          },
          "minItems": 1
        },
        "profiles": {
          "type": "array",
          "minItems": 1
        },
        "treatments": {
          "type": "array",
          "minItems": 1
        },
        "assessments": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "unknown": {
      "type": "object",
      "properties": {
        "state": {
          "const": "UNKNOWN"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "reason",
        "owner"
      ],
      "additionalProperties": false
    },
    "context": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "reference": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$(?![\\s\\S])"
        },
        {
          "type": "object",
          "properties": {
            "bundle_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            "pointer": {
              "type": "string",
              "pattern": "^/(entries|profiles|treatments|runs|comparisons|assessments)/[0-9]+$(?![\\s\\S])"
            }
          },
          "required": [
            "bundle_sha256",
            "pointer"
          ],
          "additionalProperties": false
        }
      ]
    },
    "digest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "advertised"
            }
          },
          "required": [
            "algorithm",
            "value",
            "source",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "verified"
            },
            "verification": {
              "type": "object",
              "properties": {
                "method": {
                  "const": "whole-file-sha256"
                },
                "evidence_ref": {
                  "$ref": "#/$defs/reference"
                }
              },
              "required": [
                "method",
                "evidence_ref"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "algorithm",
            "value",
            "source",
            "status",
            "verification"
          ],
          "additionalProperties": false
        }
      ]
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "index-path"
            },
            "storage": {
              "const": "git"
            },
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "storage",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "hf"
            },
            "repo_type": {
              "enum": [
                "model",
                "dataset",
                "space"
              ]
            },
            "repo_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*/[A-Za-z0-9_-][A-Za-z0-9_.-]*$(?![\\s\\S])"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
            },
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "repo_type",
            "repo_id",
            "revision",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "opaque",
            "safetensors",
            "gguf",
            "npz",
            "json",
            "jsonl"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          },
          "minItems": 1
        },
        "license": {
          "$ref": "#/$defs/context"
        }
      },
      "required": [
        "format",
        "size_bytes",
        "digest",
        "locators",
        "license"
      ],
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "changes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "authors",
        "title",
        "sources",
        "changes"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "terms": {
          "$ref": "#/$defs/context"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "notices": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "component",
        "terms",
        "source",
        "notices",
        "changes"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$(?![\\s\\S])"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1
        },
        "storage_precision": {
          "type": "string",
          "minLength": 1
        },
        "compute_precision": {
          "$ref": "#/$defs/context"
        },
        "cache_precision": {
          "$ref": "#/$defs/context"
        },
        "configuration": {
          "$ref": "#/$defs/context"
        },
        "tokenizer_template": {
          "$ref": "#/$defs/context"
        },
        "quantization": {
          "$ref": "#/$defs/context"
        },
        "runtime_build": {
          "$ref": "#/$defs/context"
        },
        "hardware": {
          "$ref": "#/$defs/context"
        }
      },
      "required": [
        "id",
        "files",
        "storage_precision",
        "compute_precision",
        "cache_precision",
        "configuration",
        "tokenizer_template",
        "quantization",
        "runtime_build",
        "hardware"
      ],
      "additionalProperties": false
    },
    "treatment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$(?![\\s\\S])"
            },
            "base_profile_ref": {
              "$ref": "#/$defs/reference"
            },
            "route": {
              "$ref": "#/$defs/context"
            },
            "output_identity": {
              "$ref": "#/$defs/evidenceOrUnknown"
            },
            "kind": {
              "const": "sparse-exact"
            },
            "rationale": {
              "const": "exact-replacements"
            },
            "payload": {
              "$ref": "#/$defs/artifact"
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "replacement_semantics": {
              "const": "stored-bits"
            }
          },
          "required": [
            "id",
            "base_profile_ref",
            "route",
            "output_identity",
            "kind",
            "rationale",
            "payload",
            "targets",
            "replacement_semantics"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$(?![\\s\\S])"
            },
            "base_profile_ref": {
              "$ref": "#/$defs/reference"
            },
            "route": {
              "$ref": "#/$defs/context"
            },
            "output_identity": {
              "$ref": "#/$defs/evidenceOrUnknown"
            },
            "kind": {
              "const": "lora"
            },
            "rationale": {
              "const": "low-rank-factors"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "payload": {
                    "$ref": "#/$defs/artifact"
                  },
                  "configuration": {
                    "$ref": "#/$defs/artifact"
                  },
                  "scale": {
                    "type": "number"
                  },
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "payload",
                  "configuration",
                  "scale",
                  "targets"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "mode": {
              "enum": [
                "runtime-adapter",
                "materialized-merge"
              ]
            },
            "conflict_policy": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "base_profile_ref",
            "route",
            "output_identity",
            "kind",
            "rationale",
            "members",
            "mode",
            "conflict_policy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$(?![\\s\\S])"
            },
            "base_profile_ref": {
              "$ref": "#/$defs/reference"
            },
            "route": {
              "$ref": "#/$defs/context"
            },
            "output_identity": {
              "$ref": "#/$defs/evidenceOrUnknown"
            },
            "kind": {
              "const": "whole-artifact"
            },
            "rationale": {
              "const": "complete-output"
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifact"
              },
              "minItems": 1
            },
            "provenance_manifest": {
              "$ref": "#/$defs/artifact"
            },
            "ordered_inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reference"
              },
              "minItems": 1
            }
          },
          "required": [
            "id",
            "base_profile_ref",
            "route",
            "output_identity",
            "kind",
            "rationale",
            "files",
            "provenance_manifest",
            "ordered_inputs"
          ],
          "additionalProperties": false
        }
      ]
    },
    "assessment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$(?![\\s\\S])"
