---
// Explainer stepper, not tied to any one model: a weight matrix, the patch as
// W + ΔW = W′, and the same W′ from LoRA factors: W + B × A. Values are illustrative.
// It cycles through the steps on its own until the reader picks one. All steps
// share one grid cell, so the stage keeps the height of the tallest. Without
// JavaScript the three steps stack.
import Heat from "./Heat.astro";
const R = 10, C = 20, seed = 4;
const edited = [3, 8, 9, 15];
const steps = [
  { label: "Weights", ms: 4500 },
  { label: "The patch", ms: 7000 },
  { label: "As a LoRA", ms: 7000 },
];
---
<div class="anatomy" data-anatomy data-step="1">
  <div class="anatomy-steps" data-slide="line" role="group" aria-label="Explainer step">
    {steps.map((s, i) => <button type="button" data-go={i + 1} aria-pressed={i === 0 ? "true" : "false"} data-ms={s.ms}>
      <span class="n">{i + 1}</span>{s.label}</button>)}
  </div>

  <div class="anatomy-stage">
    <section class="anatomy-step" data-cap="1">
      <figure class="anatomy-fig">
        <div class="mat-row">
          <div class="mat"><Heat rows={R} cols={C} kind="w" seed={seed} cell={14} label="A weight matrix drawn as a heatmap" /><span class="mat-cap">W <small>m × n</small></span></div>
        </div>
      </figure>
      <div class="anatomy-text">
        <h3>A model is a stack of weight matrices</h3>
        <p>Each cell is one number; the shade shows its size.</p>
      </div>
    </section>

    <section class="anatomy-step" data-cap="2">
      <figure class="anatomy-fig">
        <div class="mat-row">
          <div class="mat"><Heat rows={R} cols={C} kind="w" seed={seed} cell={8} /><span class="mat-cap">W</span></div>
          <span class="mat-op">+</span>
          <div class="mat"><Heat rows={R} cols={C} kind="delta" edited={edited} seed={seed} cell={8} label="The change: a few columns, each value moved by a different amount" /><span class="mat-cap">ΔW</span></div>
          <span class="mat-op">=</span>
          <div class="mat"><Heat rows={R} cols={C} kind="patched" edited={edited} seed={seed} cell={8} /><span class="mat-cap">W′</span></div>
        </div>
      </figure>
      <div class="anatomy-text">
        <h3>A patch changes a few exact cells</h3>
        <p>A few columns move, each value by its own amount. The file lists only those cells.</p>
        <table class="triples">
          <thead><tr><th>row, col</th><th>old</th><th>new</th></tr></thead>
          <tbody><tr><td>0, 3</td><td>0.0123</td><td>0.0417</td></tr><tr><td>1, 3</td><td>−0.0091</td><td>0.0034</td></tr><tr><td>0, 8</td><td>0.0215</td><td>−0.0108</td></tr></tbody></table>
      </div>
    </section>

    <section class="anatomy-step" data-cap="3">
      <figure class="anatomy-fig lora-fig">
        <div class="mat-row">
          <div class="mat"><Heat rows={R} cols={C} kind="w" seed={seed} cell={8} /><span class="mat-cap">W</span></div>
          <span class="mat-op">+</span>
          <div class="mat"><Heat rows={R} cols={edited.length} kind="b" edited={edited} seed={seed} cell={8} label="The change as two thin factors" /><span class="mat-cap">B <small>m × r</small></span></div>
          <span class="mat-op">×</span>
          <div class="mat"><Heat rows={edited.length} cols={C} kind="a" edited={edited} seed={seed} cell={8} /><span class="mat-cap">A <small>r × n</small></span></div>
          <span class="mat-op">=</span>
          <div class="mat"><Heat rows={R} cols={C} kind="patched" edited={edited} seed={seed} cell={8} /><span class="mat-cap">W′</span></div>
        </div>
      </figure>
      <div class="anatomy-text">
        <h3>The same change, as a LoRA</h3>
        <p>The change as two thin factors. Your runtime adds B × A on the fly.</p>
      </div>
    </section>
  </div>
</div>
<script>
  import { autoCycle } from "../../scripts/cycle.ts";
  for (const root of document.querySelectorAll<HTMLElement>("[data-anatomy]")) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const go = (n: number) => {
      root.dataset.step = String(n);
      buttons.forEach(b => b.setAttribute("aria-pressed", String(b.dataset.go === String(n))));
    };
    const stop = autoCycle(root, buttons, i => go(i + 1));
    buttons.forEach(b => b.addEventListener("click", () => { stop(); go(Number(b.dataset.go)); }));
    const lora = root.querySelector<HTMLElement>(".lora-fig")!;
    const light = (k: string | null) => lora.querySelectorAll<SVGElement>("[data-k]").forEach(el => el.classList.toggle("lit", el.dataset.k === k));
    lora.addEventListener("pointerover", e => light((e.target as SVGElement).dataset?.k ?? null));
    lora.addEventListener("pointerleave", () => light(null));
    root.classList.add("js");
  }
</script>
