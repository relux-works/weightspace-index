---
// Landing page for the weightspace CLI and the index's LoRA adapters.
import Arrow from "../components/Arrow.astro";
import Page from "../layouts/Page.astro";
import ShellCommand from "../components/ShellCommand.astro";
import WeightspaceMark from "../components/WeightspaceMark.astro";
import BitComparison from "../components/viz/BitComparison.astro";
import { toolApt, toolCommands, toolDownload, toolHomebrew, toolInstall } from "../lib/commands.ts";
import { humanBytes } from "../lib/format.ts";
import { href, loadIndex } from "../lib/index.ts";
import { NEW_TAB } from "../lib/links.ts";
import { highlight } from "../lib/shell.ts";
import { assetUrl, download, releasePage, toolRelease as release } from "../lib/tool-release.ts";

const index = loadIndex();
const cliGuide = index.docsAt("docs/cli.md");
const guide = index.docsAt("tool/README.md");
const notes = releasePage(index.githubRepo, release);
// The bare binary when the release has one, else the archive.
const downloads = release.assets.map(asset => {
  const file = download(asset);
  return {
    ...asset,
    size: file.size,
    href: assetUrl(index.githubRepo, release, file),
    format: file.ready ? "ready to run" : asset.os === "windows" ? "zip" : "tar.gz",
    command: toolDownload(index.githubRepo, release, asset),
  };
});
// Without script the big button offers the first recorded platform.
const main = downloads[0];
const hero = [
  "# Interactive TUI: pick engine -> local base -> pull & apply",
  "wsp",
  "",
  "# Or bake & stack replacements directly (offline)",
  "weightspace apply \\",
  "  --patch ./patch-a.safetensors --patch ./patch-b.safetensors \\",
  "  --on-conflict add --model ./my-model --out ./my-model-patched",
].join("\n");

const reasons = [
  { title: "Checks before it writes", text: "Each replaced tensor is checked against the base the patch expects: saved old values or a SHA-256. A mismatched model is refused." },
  { title: "Safe copies + verified in-place backup", text: "Default output is a new directory. Optional `--in-place` writes a SHA-256-verified backup under `.weightspace-backup/` reversible with `weightspace restore`." },
  { title: "Patch stacking + multi-registry", text: "Stack replacements with `--on-conflict=error|add|average|weighted|last-wins|first-wins`, or connect custom Git/GitLab/Gitea/HTTP registries with zero auth." },
  { title: "Interactive TUI + 8 local caches", text: "Run `wsp` to scan Hugging Face, llama.cpp, Ollama, LM Studio, mlx-serve, Strata, and ds4 caches, pull verified LoRAs/patches, and launch or print exact paths." },
];

const useIt = [
  "You want a zero-auth `wsp` CLI & TUI to search, pull, verify, and run patches or LoRAs across llama.cpp, vLLM, Ollama, LM Studio, MLX-LM, mlx-serve, Strata, or ds4.",
  "You run the unquantized target model and want the exact weights a study measured with zero adapter overhead.",
  "You want to stack multiple bit-exact replacements with explicit conflict merge rules (`add`, `average`, `weighted`).",
  "You author patches or maintain a private/community Git index (`check`, `generate`, `replacement`).",
];
const skipIt = [
  "You run GGUF or other quantized weights and want to attach adapters dynamically without re-quantizing (use `wsp pull --format gguf` or `--lora`).",
  "You want to swap multiple LoRA adapters per request in a live vLLM or llama.cpp server.",
];
---
<Page title="weightspace" nav="tool" description="Bake a bit-exact replacement into a copy of your model with weightspace, or load the LoRA adapter in a compatible runtime.">
  <section class="wrap tool-hero" aria-labelledby="tool-title">
    <header>
      <p class="tool-name"><span class="tool-label"><WeightspaceMark /><code>weightspace</code> / <code>wsp</code></span> CLI &amp; TUI</p>
      <h1 id="tool-title">Pull, stack, and bake<br />weight patches.</h1>
      <p class="lede">Discover local models, pull SHA-256-verified LoRAs and bit-exact replacements across Git/HTTP registries, stack patches safely, and launch your inference engine.</p>
      <section class="release-files tool-downloads" aria-labelledby="download-heading">
        <h2 id="download-heading">Download weightspace</h2>
        <div class="file-choices">
          <a id="tool-download" href={main.href} data-tab-select={main.os} aria-label={`Download weightspace for ${main.label} ${main.arch} · ${humanBytes(main.size)}`}>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 2v8.5M4.5 7 8 10.5 11.5 7M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span><strong data-field="label">{main.label}</strong><small data-field="hint">{main.arch} · {main.format}</small></span>
            <span class="file-size" data-field="size">{humanBytes(main.size)}</span>
          </a>
        </div>
      </section>
      <div class="release-meta">
        <ul class="platform-links" aria-label="All platforms">
          {downloads.map(d => <li><a href={d.href} data-os={d.os} data-tab-select={d.os} data-label={d.label} data-hint={`${d.arch} · ${d.format}`} data-size={humanBytes(d.size)} aria-label={`Download weightspace for ${d.label} ${d.arch} · ${humanBytes(d.size)}`}>{d.label}</a></li>)}
        </ul>
        <a class="release-tag" href={notes} {...NEW_TAB} aria-label={`Release notes for ${release.tag}`}>{release.tag} <Arrow dir="out" /></a>
      </div>
    </header>
    <figure class="terminal sh hero-terminal">
      <figcaption>Apply a patch to a copy</figcaption>
      <pre tabindex="0"><code set:html={highlight(hero)} /><span class="out">patched model written: ./my-model-patched</span></pre>
    </figure>
  </section>

  <section class="home-band subtle" id="exact" aria-labelledby="exact-heading">
    <!-- Keep links to the former #optional section pointing here. -->
    <div class="wrap" id="optional">
      <div class="band-title"><h2 id="exact-heading">Bit-exact replacements</h2></div>
      <div class="replacement-layout">
        <div class="replacement-copy">
          <p>
            The <code><span class="tool-label"><WeightspaceMark />weightspace apply</span></code> command bakes the published weights bit for bit into a copy of the matching unquantized model.
            The patched copy avoids the extra matrix multiplies per token and the memory used by an attached LoRA’s weights.
          </p>
          <p>Load our LoRA adapter in a <a href={href("how-it-works/#why-both")}>compatible runtime</a>, including on supported quantized models.</p>
        </div>
        <BitComparison />
      </div>
    </div>
  </section>

  <section class="home-band" id="why" aria-labelledby="why-heading">
    <div class="wrap">
      <div class="band-title"><h2 id="why-heading">Why it's worth it</h2></div>
      <ul class="reasons">
        {reasons.map(reason => <li><h3>{reason.title}</h3><p>{reason.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="home-band subtle" id="when" aria-labelledby="when-heading">
    <div class="wrap">
      <div class="band-title"><h2 id="when-heading">When to use it</h2></div>
      <div class="when">
        <div>
          <h3>Reach for it when</h3>
          <ul>{useIt.map(item => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h3>Use the LoRA when</h3>
          <ul>{skipIt.map(item => <li>{item}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="home-band" id="install" aria-labelledby="install-heading">
    <div class="wrap">
      <div class="band-title">
        <h2 id="install-heading">Install and run</h2>
        <p>Binaries in {release.tag} are tool {release.toolVersion}. Build from source for the latest commands.</p>
      </div>
      <div class="install" data-tabs id="install-tabs">
        <div class="setup-tabs" data-slide="line" role="tablist" hidden aria-label="Platform">
          {downloads.map((d, i) => <button role="tab" type="button" data-label={d.os} aria-selected={String(i === 0)}>{d.label}</button>)}
          <button role="tab" type="button" data-label="homebrew" aria-selected="false">Homebrew</button>
          <button role="tab" type="button" data-label="apt" aria-selected="false">APT (Debian/Ubuntu)</button>
          <button role="tab" type="button" data-label="source" aria-selected="false">From source</button>
        </div>
        {downloads.map(d => <div class="install-panel" data-panel>
          <h3 class="panel-title">{d.label}</h3>
          <ShellCommand command={d.command} title={`Download, verify and install · ${d.arch}`} />
        </div>)}
        <div class="install-panel" data-panel>
          <h3 class="panel-title">Homebrew (macOS &amp; Linux)</h3>
          <ShellCommand command={toolHomebrew()} title="Developer ID signed & notarized on macOS · installs weightspace + wsp" />
        </div>
        <div class="install-panel" data-panel>
          <h3 class="panel-title">APT (Debian / Ubuntu)</h3>
          <ShellCommand command={toolApt()} title="Signed Relux Works APT repo (amd64 & arm64) · .deb also on GitHub Releases" />
        </div>
        <div class="install-panel" data-panel>
          <h3 class="panel-title">From source</h3>
          <ShellCommand command={toolInstall(index.githubRepo)} title="Build & install weightspace + wsp with Rust 1.85+" />
        </div>
      </div>
      <div class="run-cmds">
        <ShellCommand command={toolCommands.tui} title="Interactive TUI & hf-style CLI (wsp)" />
        <ShellCommand command={toolCommands.stack} title="Stack replacements & in-place backup/restore" />
        <ShellCommand command={toolCommands.apply} title="Apply a single replacement (copy)" />
        <ShellCommand command={toolCommands.replacement} title="Build a patch (authors)" />
      </div>
      <p class="fine">See the full step-by-step <a href={cliGuide} {...NEW_TAB}>CLI &amp; TUI guide (<code>docs/cli.md</code>)</a> for registry setup, conflict-merge math, and all 9 inference engines. If a patch stores whole tensors, <code>apply</code> also needs their expected base digests (<a href={`${guide}#apply-a-replacement-patch-patch-users`} {...NEW_TAB}>low-level details</a>).</p>
    </div>
  </section>

  <section class="home-band subtle" aria-labelledby="closing-heading">
    <div class="wrap closing">
      <h2 id="closing-heading">Find a patch for your model</h2>
      <div class="closing-actions">
        <a class="btn primary" href={href()}>Browse models <Arrow /></a>
        <a class="btn" href={href("how-it-works/")}>Patch vs LoRA</a>
      </div>
    </div>
  </section>
</Page>

<script>
  import "../scripts/tabs.ts";
  // Put the visitor's platform first: it takes the dark primary row and its install tab.
  const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
  const platform = `${nav.userAgentData?.platform ?? ""} ${navigator.platform} ${navigator.userAgent}`;
  const os = /Win/i.test(platform) ? "windows" : /Android|iPhone|iPad/i.test(platform) ? null
    : /Mac/i.test(platform) ? "macos" : /Linux|X11/i.test(platform) ? "linux" : null;
  // The one big button points at the visitor's platform; the links below keep all three.
  const button = document.getElementById("tool-download") as HTMLAnchorElement | null;
  const link = os && document.querySelector<HTMLAnchorElement>(`.platform-links a[data-os="${os}"]`);
  if (button && link) {
    button.href = link.href;
    button.dataset.tabSelect = os;
    button.setAttribute("aria-label", link.getAttribute("aria-label")!);
    for (const field of ["label", "hint", "size"] as const) {
      button.querySelector(`[data-field="${field}"]`)!.textContent = link.dataset[field]!;
    }
    link.setAttribute("aria-current", "true");
    document.querySelector<HTMLButtonElement>(`#install-tabs [role=tab][data-label="${os}"]`)?.click();
  }
</script>

<style>
  .tool-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: center; gap: 2rem clamp(2rem, 5vw, 4.5rem); padding-block: clamp(2rem, 5vw, 4.8rem); }
  .tool-name { color: var(--color-text-muted); font-size: .95rem; }
  .tool-label { display: inline-flex; align-items: baseline; gap: var(--space-1); }
  .tool-name code { color: var(--color-text); font-weight: 600; }
  .tool-hero h1 { margin-top: .6rem; font-size: clamp(2.3rem, 4.6vw, 4rem); line-height: .98; font-weight: 680; letter-spacing: -.035em; }
  .lede { margin-top: 1.1rem; max-width: 40ch; color: var(--color-text-muted); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.55; }
  /* Same rows as the patch page's "Download files" (.release-files). */
  .tool-downloads { margin-top: 1.8rem; max-width: 26rem; }
  /* A quiet caption as wide as the button: every platform, then the release. */
  .release-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; max-width: 26rem; font-size: .85rem; color: var(--color-text-muted); }
  .release-meta a { display: inline-flex; align-items: center; gap: .2rem; min-height: 2.75rem; color: inherit; text-decoration: none; }
  .release-meta a:hover { color: var(--color-link); text-decoration: underline; }
  .platform-links { list-style: none; margin: 0; padding: 0; display: flex; }
  .platform-links li + li::before { content: "·"; padding-inline: .45rem; }
  .platform-links a[aria-current] { color: var(--color-text); font-weight: 600; }
  .release-tag { font-variant-numeric: tabular-nums; }

  .install, .install-panel { min-width: 0; }
  .install-panel:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 4px; }
  .run-cmds { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .hero-terminal { margin: 0; min-width: 0; }
  .hero-terminal pre { overflow-x: auto; }
  .hero-terminal .out { display: block; margin-top: .6rem; color: var(--ink-muted); }

  .fine { margin-top: 1rem; max-width: 70ch; font-size: .9rem; color: var(--color-text-muted); }

  .replacement-layout { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: 1.5rem clamp(1.5rem, 4vw, 3.5rem); }
  .replacement-copy { max-width: 53ch; color: var(--color-text-muted); }
  .replacement-copy p + p { margin-top: .75rem; }
  .replacement-copy code {
    background: var(--color-surface-raised);
    border: 1px solid color-mix(in srgb, var(--color-border-strong) 80%, var(--color-border));
    color: var(--color-text);
    padding: .1em .3em;
    border-radius: var(--radius-surface);
    white-space: nowrap;
  }

  .reasons { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem clamp(1.5rem, 3vw, 2.5rem); }
  .reasons li { border-top: 1px solid var(--color-divider); padding-top: 1rem; }
  .reasons h3 { font-size: 1.1rem; }
  .reasons p { margin-top: .4rem; color: var(--color-text-muted); font-size: .95rem; }

  .when { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 3.5rem); }
  .when h3 { font-size: 1.1rem; border-top: 2px solid var(--color-text); padding-top: 1rem; }
  .when ul { margin: .8rem 0 0; padding-left: 1.2rem; display: grid; gap: .5rem; color: var(--color-text-muted); }

  .closing { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem 3rem; flex-wrap: wrap; }
  .closing h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); margin: 0; }
  .closing-actions { display: flex; flex-wrap: wrap; gap: .75rem; }

  @media (max-width: 60rem) {
    .tool-hero, .replacement-layout, .run-cmds { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 40rem) {
    .when, .reasons { grid-template-columns: minmax(0, 1fr); }
  }
</style>
