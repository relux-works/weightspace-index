---
import Arrow from "../components/Arrow.astro";
import Page from "../layouts/Page.astro";
import ModelCard from "../components/catalog/ModelCard.astro";
import Filter from "../components/catalog/Filter.astro";
import FormatComparison from "../components/viz/FormatComparison.astro";
import ShellCommand from "../components/ShellCommand.astro";
import { activeVersion } from "../lib/catalog.ts";
import { href, loadIndex } from "../lib/index.ts";
import { plural } from "../lib/format.ts";

const index = loadIndex();
// Put the richest base models first (most active patches, then alphabetical).
const models = [...index.bases].sort((a, b) => {
  const ca = a.patches.filter(p => activeVersion(p)).length;
  const cb = b.patches.filter(p => activeVersion(p)).length;
  return cb - ca || a.address.localeCompare(b.address);
});
const totalPatches = models.reduce((n, b) => n + b.patches.filter(p => activeVersion(p)).length, 0);

// Isometric box geometry (top, left, right faces) for the hero pile-of-boxes comparison.
function isoBox(cx: number, cy: number, rx: number, ry: number, h: number) {
  return {
    top: `${cx},${cy - ry} ${cx + rx},${cy} ${cx},${cy + ry} ${cx - rx},${cy}`,
    left: `${cx - rx},${cy} ${cx},${cy + ry} ${cx},${cy + ry + h} ${cx - rx},${cy + h}`,
    right: `${cx},${cy + ry} ${cx + rx},${cy} ${cx + rx},${cy + h} ${cx},${cy + ry + h}`,
  };
}
const fullPile = [114, 91, 68, 45].map(cy => isoBox(64, cy, 42, 15, 22));
const baseBox = isoBox(196, 114, 42, 15, 22);
const patchSheets = [109.5, 105.5, 101.5, 97.5].map(cy => isoBox(196, cy, 42, 15, 2.5));

const registryExample = {
  text: [
    "# Add any Git-hosted index (GitHub, private GitLab, Gitea, or local mirror)",
    "wsp registry add internal ssh://git@gitlab.internal/ml/weightspace-index.git",
    "wsp registry pin internal v2026.11",
    "",
    "# Or browse & apply patches interactively in your terminal",
    "wsp",
  ].join("\n"),
  source: { path: "AGENTS.md", label: "AGENTS.md" },
};
---
<Page title="Weightspace Index" nav="models" description="Download a base model once and apply verified weight patches or native LoRA adapters — with before/after benchmarks, pinned SHA-256 digests, and one-command wsp launch.">
  <div class="wrap home-hero">
    <div class="hero-grid">
      <header class="find-intro">
        <h1>Download the base once. <br />Patch it for every job.</h1>
        <p>
          Swap verified LoRAs or bit&#8209;exact weight patches on one open model instead of re&#8209;downloading 50&nbsp;GB fine&#8209;tunes.
        </p>
        <div class="hero-actions">
          <a class="btn primary" href="#models">Browse {plural(totalPatches, "patch", "patches")} <Arrow dir="down" /></a>
          <a class="text-link" href={href("how-it-works/")}>How patches work <Arrow /></a>
        </div>
      </header>

      <aside class="hero-visual" aria-label="Storage comparison">
        <figure class="piles">
          <svg
            class="piles-svg"
            viewBox="0 0 260 154"
            role="img"
            aria-label="A tall pile of four full model boxes beside one base model box topped with four thin patch layers."
          >
            <g class="pile-full">
              {fullPile.map(box => (
                <g class="iso-box">
                  <polygon class="iso-left" points={box.left} />
                  <polygon class="iso-right" points={box.right} />
                  <polygon class="iso-top" points={box.top} />
                </g>
              ))}
            </g>
            <g class="pile-patched">
              <g class="iso-box is-base">
                <polygon class="iso-left" points={baseBox.left} />
                <polygon class="iso-right" points={baseBox.right} />
                <polygon class="iso-top" points={baseBox.top} />
              </g>
              {patchSheets.map(sheet => (
                <g class="iso-sheet">
                  <polygon class="iso-left" points={sheet.left} />
                  <polygon class="iso-right" points={sheet.right} />
                  <polygon class="iso-top" points={sheet.top} />
                </g>
              ))}
            </g>
          </svg>
          <figcaption class="piles-caption">
            <span>Full models</span>
            <span class="is-patched">Patches</span>
          </figcaption>
        </figure>
      </aside>
    </div>

    <section class="directory" id="models" aria-labelledby="directory-heading">
      <div class="directory-label">
        <div>
          <h2 id="directory-heading">Choose a base model</h2>
          <span class="dir-count">{plural(models.length, "model")} · {plural(totalPatches, "active patch", "active patches")}</span>
        </div>
        <a class="btn" href={href("submit/")}>+ Add model / patch</a>
      </div>
      {models.length > 0 && <Filter target="model-list" label="Filter by model, harness, tag, or author (e.g. 27B, pi, opencode, SWE)" noun="models" one="model" searchHref={href("search/")} />}
      <p class="filter-status" role="status" id="model-list-status"></p>
      <ul class="model-list" id="model-list">{models.map(base => <ModelCard base={base} />)}</ul>
      {!models.length && <p class="quiet-row">No models have been published yet.</p>}
    </section>
  </div>

  <FormatComparison />

  <section class="home-band" id="registries" aria-labelledby="registries-heading">
    <div class="wrap registry-band">
      <div class="registry-copy">
        <h2 id="registries-heading">Use custom &amp; private Git registries</h2>
        <p>
          An index is just a Git repository with contract-v1 JSON files — no GitHub lock-in and no API account required.
          Connect internal GitLab mirrors, pin a specific commit or tag for reproducible deployments, or add third-party community registries (including separate indexes for abliterated patches).
        </p>
        <div class="registry-links">
          <a class="text-link" href={href("submit/")}>Publish to an index <Arrow /></a>
          <a class="text-link" href={href("agent.md")}>Read agent.md <Arrow /></a>
        </div>
      </div>
      <ShellCommand command={registryExample} title="Multi-registry setup with wsp" />
    </div>
  </section>
</Page>

<style>
  .home-hero {
    padding-block: clamp(var(--space-6), 3.8vw, var(--space-12)) clamp(var(--space-8), 4.5vw, var(--space-16));
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--space-6) clamp(var(--space-8), 4.5vw, var(--space-12));
    padding-bottom: clamp(var(--space-6), 3.5vw, var(--space-12));
    border-bottom: 1px solid var(--color-divider);
  }
  .home-hero .find-intro h1 {
    font-size: clamp(1.85rem, 3.6vw, 3.35rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: none;
  }
  .home-hero .find-intro p {
    margin-top: var(--space-4);
    max-width: 48ch;
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.55;
  }
  .hero-actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
  }
  .hero-actions .btn {
    min-height: 2.5rem;
    padding-inline: var(--space-4);
    font-size: 0.9375rem;
  }
  .hero-actions .btn.primary :global(.arrow) {
    transition: transform var(--motion-fast) var(--motion-ease);
  }
  .hero-actions .btn.primary:hover :global(.arrow) {
    transform: translateY(2px);
  }
  .hero-actions .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.5rem;
    padding-inline: var(--space-1);
    margin-inline: calc(var(--space-1) * -1);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    white-space: nowrap;
  }
  .hero-actions .text-link:hover {
    text-decoration-color: currentColor;
  }

  .hero-visual {
    display: grid;
    justify-items: center;
    min-width: 0;
  }
  .piles {
    margin: 0;
    width: min(100%, 21.5rem);
    display: grid;
    gap: var(--space-2);
  }
  .piles-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .pile-full {
    opacity: 0.72;
  }
  .iso-box polygon {
    stroke: var(--color-border-strong);
    stroke-width: 0.85;
    stroke-opacity: 0.55;
    stroke-linejoin: round;
  }
  .iso-box.is-base polygon {
    stroke-opacity: 0.72;
  }
  .iso-box .iso-top {
    fill: var(--color-surface);
  }
  .iso-box .iso-left {
    fill: var(--color-surface-subtle);
  }
  .iso-box .iso-right {
    fill: color-mix(in srgb, var(--color-border) 55%, var(--color-surface-subtle));
  }
  .iso-sheet polygon {
    stroke: color-mix(in oklch, var(--color-accent) 48%, var(--color-border));
    stroke-width: 0.7;
    stroke-linejoin: round;
  }
  .iso-sheet .iso-top {
    fill: color-mix(in oklch, var(--color-accent) 28%, var(--color-surface));
  }
  .iso-sheet .iso-left {
    fill: color-mix(in oklch, var(--color-accent) 48%, var(--color-surface-subtle));
  }
  .iso-sheet .iso-right {
    fill: color-mix(in oklch, var(--color-accent) 62%, var(--color-surface-subtle));
  }
  .piles-caption {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--color-text-faint);
    text-align: center;
  }
  .piles-caption .is-patched {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .home-hero .directory { margin-top: var(--space-8); padding: 0; border: 0; }
  .dir-count { display: block; color: var(--color-text-muted); font-size: .84rem; margin-top: .15rem; }
  :global(.model-entry__right) { display: inline-flex; align-items: center; gap: .85rem; flex-shrink: 0; }
  :global(.model-entry__gain) {
    font: 600 .8rem/1 var(--font-mono); color: var(--color-accent);
    padding: .3rem .55rem; border-radius: .25rem; background: var(--color-surface-subtle);
    white-space: nowrap;
  }
  .registry-band { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 1.5rem 3rem; align-items: center; }
  .registry-copy h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .registry-copy p { margin-top: .7rem; color: var(--color-text-muted); max-width: 52ch; }
  .registry-links { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 1.25rem; }
  @media (pointer: coarse) {
    .hero-actions .btn,
    .hero-actions .text-link {
      min-height: 2.75rem;
    }
  }
  @media (max-width: 56rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-visual {
      justify-items: start;
      max-width: 28rem;
    }
  }
  @media (max-width: 52rem) {
    .registry-band { grid-template-columns: minmax(0, 1fr); }
    :global(.model-entry__gain) { display: none; }
  }
  @media (max-width: 30rem) {
    .hero-actions { gap: var(--space-2) var(--space-4); }
    .hero-actions .btn { font-size: 0.875rem; padding-inline: var(--space-3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-actions .btn.primary:hover :global(.arrow) { transform: none; }
  }
  @media (forced-colors: active) {
    .iso-box polygon { forced-color-adjust: none; fill: Canvas; stroke: CanvasText; }
    .iso-sheet polygon { forced-color-adjust: none; fill: Highlight; stroke: CanvasText; }
  }
</style>
