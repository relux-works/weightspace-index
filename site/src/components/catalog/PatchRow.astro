---
import type { Patch } from "../../lib/types.ts";
import { activeVersion, discoveryText, formats } from "../../lib/catalog.ts";
import { authorReport } from "../../data/reports.ts";
interface Props { patch: Patch }
const { patch } = Astro.props;
const release = activeVersion(patch);
const report = authorReport(release);
const forms = formats(release);
const complete = release?.runs.filter(r => r.record.state === "COMPLETE" && typeof r.record.score.value === "number").length ?? 0;
const signal = complete ? "Benchmark available" : release?.runs.length ? "Benchmark in progress" : report ? "Author report" : "Awaiting benchmarks";
---
<article class="patch-item" data-search={discoveryText(patch.base.address, [patch], forms) + " " + (report?.goal ?? "").toLowerCase()}>
  <a href={patch.url} class="patch-row-link">
    <div><div class="item-by">{patch.authors.map(a => a.name).join(", ")}{release && <> · {release.label}</>}</div>
      <h3>{report?.name ?? patch.title}</h3><p>{report?.goal ?? patch.summary.replace(/^SYNTHETIC EXAMPLE:\s*/i, "")}</p>
    </div>
    <div class="patch-meta"><div class="chips">{forms.map(f => <span>{f}</span>)}</div><span>{release ? signal : "No active release"}</span></div>
    <span class="tile-arrow" aria-hidden="true">→</span>
  </a>
</article>
