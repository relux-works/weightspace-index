---
import Page from "../../../../layouts/Page.astro";
import FileList from "../../../../components/FileList.astro";
import GroupResults from "../../../../components/GroupResults.astro";
import { rankings } from "../../../../lib/rank.ts";
import Evidence from "../../../../components/catalog/Evidence.astro";
import Combinations from "../../../../components/catalog/Combinations.astro";
import Filter from "../../../../components/catalog/Filter.astro";
import PatchRow from "../../../../components/catalog/PatchRow.astro";
import { href, loadIndex, profileFiles, type Base } from "../../../../lib/index.ts";
import { activeVersion, formats } from "../../../../lib/catalog.ts";
import { plural } from "../../../../lib/format.ts";
import { authorReport } from "../../../../data/reports.ts";
export function getStaticPaths() {
  return loadIndex().bases.map(base => ({ params: { ns: base.ns, model: base.model }, props: { base } }));
}
interface Props { base: Base }
const { base } = Astro.props;
const releases = base.patches.map(activeVersion).filter(v => !!v);
const measured = releases.filter(v => v.runs.length || authorReport(v));
const comparisons = base.groups.flatMap(group => rankings(group).flatMap(r => {
  const runs = r.runs.filter(run => !run.version || run.version.isLatest);
  return new Set(runs.flatMap(run => run.version ? [run.version.patch.slug] : [])).size > 1
    ? [{ group, ranking: { ...r, runs } }] : [];
}));
const forms = [...new Set(releases.flatMap(v => formats(v)))];
---
<Page title={base.address} description={`Browse and download patches for ${base.address}.`} nav="models">
  <div class="wrap page-flow">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={href()}>Models</a><span>/</span><span aria-current="page">{base.model}</span></nav>
    <header class="model-head overview"><p class="context-label">{base.ns} / Base model</p><h1>{base.model}</h1>
      <div class="model-facts"><span>{plural(base.patches.length, "patch", "patches")}</span>{forms.length > 0 && <span>{forms.join(" + ")}</span>}
        <a href="#profiles">{base.profiles.map(p => p.id.toUpperCase()).join(" / ")}</a></div>
    </header>
    <nav class="local-nav" aria-label="Model sections"><a href="#patches">Patches</a>{measured.length > 0 && <a href="#results">Benchmarks</a>}<a href="#combinations">Combinations</a><a href="#profiles">Base files</a></nav>
    <section class="flow-section" id="patches">
      <div class="directory-head"><h2>Available patches</h2>{base.patches.length > 1 && <Filter target="patch-list" label="Filter patches" noun="patches"/>}</div>
      <p class="filter-status" id="patch-list-status" role="status"></p>
      <div id="patch-list">{base.patches.map(patch => <PatchRow patch={patch} />)}</div>
      {!base.patches.length && <p class="quiet-row">This model has no published patches yet. Its supported base files are listed below.</p>}
    </section>
    {measured.length > 0 && <section class="flow-section" id="results"><h2>Benchmark evidence</h2>
      {comparisons.map(({ group, ranking }) => <GroupResults group={group} ranking={ranking}/>)}
      {measured.slice(0, 4).map((v,i) => measured.length === 1 ? <Evidence version={v}/> : <details class="fold" open={i === 0}>
        <summary>{authorReport(v)?.name ?? v.patch.title} · {v.label}</summary><Evidence version={v}/></details>)}
      {measured.length > 4 && <details class="fold"><summary>{measured.length - 4} more patch reports</summary>
        {measured.slice(4).map(v => <details class="fold"><summary>{v.patch.title} · {v.label}</summary><Evidence version={v}/></details>)}</details>}
    </section>}
    <Combinations base={base} />
    <section class="flow-section" id="profiles"><h2>Base files</h2>
      {base.profiles.map(p => <details class="fold" id={`profile-${p.id}`}><summary>{p.id.toUpperCase()} · {p.source.repo_id} <code>@{p.source.revision.slice(0,7)}</code></summary>
        <FileList files={profileFiles(p)} showRole={false} /></details>)}
      <details class="fold" id="records"><summary>Model record and benchmark runs</summary><a href={base.baseRecord.view}>Base record</a>
        {base.groups.map(g => <div id={g.id}><h3>{g.protocolLabel} · {g.profile.id}</h3>{g.runs.map(r => <p><a href={r.url}>{r.version ? r.version.patch.title + " " + r.version.label : "Unpatched base"} · {r.record.state}</a></p>)}</div>)}</details>
    </section>
  </div>
</Page>
