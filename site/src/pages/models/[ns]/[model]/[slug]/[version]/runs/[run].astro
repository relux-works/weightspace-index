---
import Page from "../../../../../../../layouts/Page.astro";
import RunView from "../../../../../../../components/RunView.astro";
import { href, loadIndex, type Run } from "../../../../../../../lib/index.ts";

export function getStaticPaths() {
  return loadIndex().bases.flatMap((base) =>
    base.patches.flatMap((patch) =>
      patch.versions.flatMap((version) =>
        version.runs.map((run) => ({
          params: { ns: base.ns, model: base.model, slug: patch.slug, version: version.label, run: run.id },
          props: { run },
        })),
      ),
    ),
  );
}
interface Props { run: Run }
const { run } = Astro.props;
const v = run.version!;
const base = run.base;
---
<Page
  title={`Run ${run.id} · ${v.patch.slug} ${v.label}`}
  description={`Benchmark run of ${v.patch.title} ${v.label} on ${base.address}.`}
  nav="models"
  crumbs={[
    { label: "Models", href: href() },
    { label: base.address, href: base.url },
    { label: v.patch.slug, href: v.patch.url },
    { label: v.label, href: v.url },
    { label: run.id },
  ]}
>
  <RunView run={run} />
</Page>
