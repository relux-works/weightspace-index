---
// One benchmark group on a base page: the best single patch and a chart of
// recorded scores when complete runs exist, otherwise the runs in progress.
import type { Group } from "../lib/index.ts";
import { href } from "../lib/index.ts";
import { BUCKET_LABEL, barLabel, rankings } from "../lib/rank.ts";
import { plural } from "../lib/format.ts";
import Badge from "./Badge.astro";
import BarChart from "./BarChart.astro";
import Score from "./Score.astro";
interface Props { group: Group }
const { group } = Astro.props;
const ranks = rankings(group);
const pending = group.runs.filter((r) => r.record.state !== "COMPLETE" || typeof r.record.score.value !== "number");
---
<article class="card" id={group.id}>
  <div class="card-head">
    <h3>{group.protocolLabel} <span class="muted">· {group.settingsLabel}</span></h3>
    <span class="tag" title="Base profile">{group.profile.id}</span>
    <a class="small" href={href(`compare/#${group.id}`)}>Compare runs</a>
  </div>
  <p class="small muted">
    Dataset <span class="mono break">{group.dataset.name}</span>. One profile, protocol, dataset and settings; nothing from other groups is mixed in.
  </p>

  {ranks.map((r) => (
    <div class="stack" style="margin-top: var(--space-6)">
      <p class="eyebrow">{BUCKET_LABEL[r.bucket]} · {plural(r.runs.length, "complete run")}</p>
      {r.best.length > 0 ? (
        <div class="best">
          <span class="best-value">{r.best[0].record.score.value}</span>
          <div>
            <p class="eyebrow">Best single patch{r.best.length > 1 ? " (tie)" : ""}</p>
            <p>
              {r.best.map((b, i) => <>{i > 0 && ", "}<a href={b.url}>{barLabel(b)}</a></>)}
              <span class="muted"> · {r.metric} ({r.unit}), the highest recorded score among active patched versions in this group</span>
            </p>
          </div>
        </div>
      ) : (
        <p class="muted small">No complete run of an active patched version in this group yet.</p>
      )}
      <BarChart
        caption={`${group.label}: ${r.metric}`}
        metric={r.metric}
        unit={r.unit}
        bars={r.runs.map((run) => ({
          label: barLabel(run),
          sub: `n = ${run.record.score.denominator} · ${run.record.performed_by}`,
          value: run.record.score.value!,
          href: run.url,
          base: !run.version,
        }))}
      />
    </div>
  ))}

  {pending.length > 0 && (
    <div class="stack" style="margin-top: var(--space-6)">
      <p class="eyebrow">{ranks.length === 0 ? "No complete runs yet" : "Not ranked"} · {plural(pending.length, "run")}</p>
      <p class="small muted">Rankings and charts use COMPLETE runs with a recorded score only.</p>
      <div class="table-wrap">
        <table class="compact">
          <thead><tr><th>Run</th><th>Measured by</th><th>State</th><th>Score</th></tr></thead>
          <tbody>
            {pending.map((r) => (
              <tr>
                <td><a href={r.url}>{barLabel(r)}</a></td>
                <td>{r.record.performed_by}</td>
                <td><Badge state={r.record.state} /></td>
                <td><Score score={r.record.score} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}
</article>
