---
// Every patch's results for one model in a plain table per measuring source,
// so patches can be compared without mixing self-reported and independent
// numbers (rule 9).
import type { Base } from "../../lib/types.ts";
import { activeVersion, sourceLabels } from "../../lib/catalog.ts";
import { authorReport } from "../../data/reports.ts";
import { results, pending, groupEvidence, fmt, signed, gain, type Result } from "../../lib/insight.ts";
interface Props { base: Base }
const { base } = Astro.props;
const releases = base.patches.map(activeVersion).filter(v => !!v);
const all = releases.flatMap(v => results(v));
const waiting = releases.flatMap(v => pending(v));
const nameOf = (r: { version: Result["version"] }) => authorReport(r.version)?.name ?? r.version.patch.title;
const groups = groupEvidence(all, waiting, []).filter(g => g.scores.length || g.progress.length);
---
{groups.map(g => <div class="rtable-wrap">
  <p class="rgroup-head"><span class:list={["src-chip", g.source === "author" ? "self" : "indep"]}>{sourceLabels[g.source]}</span></p>
  {g.scores.length > 0 && <table class="rtable">
    <thead><tr><th>Benchmark</th><th>Patch</th><th class="num">Base</th><th class="num">Patched</th><th class="num">Change</th></tr></thead>
    <tbody>{g.scores.map(r => {
      const d = gain(r);
      return <tr>
        <td>{r.benchmark}{r.metric && <small> {r.metric}</small>}</td>
        <td><a href={r.version.patch.url}>{nameOf(r)}</a></td>
        <td class="num muted">{fmt(r.base, r.unit)}</td>
        <td class="num"><strong>{fmt(r.patched, r.unit)}</strong></td>
        <td class="num"><span class:list={["delta", d > 0 ? "up" : d < 0 ? "down" : "flat"]}>{signed(r.patched - r.base, r.unit)}</span></td>
      </tr>;
    })}</tbody>
  </table>}
  {g.progress.length > 0 && <p class="rnote">Measurement in progress · {g.progress.map((w, i) => <>{i > 0 && ", "}<a href={w.href}>{nameOf(w)} · {w.benchmark}</a> ({w.filed}/{w.total} item–seed pairs)</>)}</p>}
</div>)}
{!groups.length && <p class="quiet-row">No scored results yet.</p>}
