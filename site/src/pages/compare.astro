---
// Every benchmark group of every base, one table each. A group is one profile,
// protocol, dataset and settings; runs are never compared across groups.
import Page from "../layouts/Page.astro";
import Badge from "../components/Badge.astro";
import Hash from "../components/Hash.astro";
import Head from "../components/Head.astro";
import Section from "../components/Section.astro";
import Score from "../components/Score.astro";
import { href, loadIndex, measuredBy, type Run } from "../lib/index.ts";
import { BUCKET_LABEL, barLabel } from "../lib/rank.ts";

const index = loadIndex();
const order = (a: Run, b: Run) =>
  (a.version ? 1 : 0) - (b.version ? 1 : 0) || barLabel(a).localeCompare(barLabel(b)) || a.id.localeCompare(b.id);
---
<Page title="Compare" nav="compare" description="Benchmark runs side by side, one table per profile, protocol, dataset and settings.">
  <Head>
    <h1>Runs side by side</h1>
    <p class="lead">
      One table per base, profile, protocol, dataset and settings. Runs in different tables are not comparable and are never ranked together. Scores are as recorded; no differences or intervals are computed here.
    </p>
  </Head>

  {index.bases.every((b) => b.groups.length === 0) ? (
    <section class="band"><div class="wrap"><p class="empty"><strong>No benchmarks submitted</strong>No run records exist in the index yet.</p></div></section>
  ) : (
    index.bases.filter((b) => b.groups.length > 0).map((base) => (
      <Section title={base.address} id={`base-${base.ns}-${base.model}`}>
        <Fragment slot="intro"><a href={base.url}>Open the model</a> to browse patches and benchmark evidence.</Fragment>
        <div class="cards">
          {base.groups.map((g) => (
            <article class="card" id={g.id}>
              <div class="card-head">
                <h3>{g.protocolLabel} <span class="muted">· {g.settingsLabel}</span></h3>
                <span class="tag" title="Base profile">{g.profile.id}</span>
              </div>
              <dl class="facts" style="margin-bottom: var(--space-4)">
                <div><dt>Protocol</dt><dd><span class="mono">{g.protocol.name}</span><br /><Hash value={g.protocol.sha256} n={12} /></dd></div>
                <div><dt>Dataset</dt><dd><span class="mono">{g.dataset.name}</span><br /><Hash value={g.dataset.sha256} n={12} /></dd></div>
                <div><dt>Runs</dt><dd>{g.runs.length}</dd></div>
              </dl>
              <div class="table-wrap">
                <table class="compact">
                  <thead>
                    <tr><th>Treatment</th><th>Run</th><th>Measured by</th><th>State</th><th>Score</th><th>Paired with</th></tr>
                  </thead>
                  <tbody>
                    {[...g.runs].sort(order).map((r) => (
                      <tr>
                        <td>{r.version ? <a href={r.version.url}>{barLabel(r)}</a> : "unpatched base"}</td>
                        <td><a href={r.url} class="mono small">{r.id}</a></td>
                        <td title={BUCKET_LABEL[measuredBy(r)]}>{r.record.performed_by}</td>
                        <td><Badge state={r.record.state} /></td>
                        <td><Score score={r.record.score} compact /></td>
                        <td>{r.paired ? <a href={r.paired.url} class="small">{barLabel(r.paired)}</a> : <span class="muted small">none</span>}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="small muted" style="margin-top: var(--space-3)"><a href={`${base.url}#${g.id}`}>See this group on the model page</a>.</p>
            </article>
          ))}
        </div>
      </Section>
    ))
  )}
</Page>
