---
// Reported stacks of patches. Any set of patches can be applied together; the
// site shows only the stacks someone benchmarked. Model page: a picker over the
// active patches and a list of measured stacks (a preset for the picker),
// sorted by how far each stack beats its best single patch; both filter one
// list of report cards in the browser. Patch page: the reports that include
// this release. Each card leads with the stack against its best patch alone
// (or the base, when no solo scores were filed), then against the sum of the
// solo changes, and draws every change from the unpatched base. One measuring
// source per card (rule 9).
import type { Base, Version } from "../../lib/types.ts";
import { loadIndex } from "../../lib/index.ts";
import { SUM_LABEL, type Standing } from "../../lib/combinations.ts";
import { activeVersion, sourceLabels } from "../../lib/catalog.ts";
import { combos, fmt, type Combo } from "../../lib/insight.ts";
interface Props { base: Base; version?: Version }
const { base, version } = Astro.props;
const index = loadIndex();
const all = combos(base, version);
const releases = base.patches.map(activeVersion).filter(v => !!v);
const current = (s: Combo) => s.members.every(m => m.release.isLatest && m.release.status === "active");
const byLead = (a: Combo, b: Combo) => b.reading.lead.gap - a.reading.lead.gap || a.key.localeCompare(b.key);
const live = (version ? all : all.filter(current)).sort(byLead);
const earlier = version ? [] : all.filter(s => !current(s));
const submit = index.docsAt("docs/benchmarking.md") + "#combination-studies";
const nameOf = (v: Version) => v.patch.title;
const untested = version ? releases.filter(v => v !== version && !all.some(s => s.members.some(m => m.release.patch === v.patch))) : [];

/** A signed change in the metric's units: "+8 pts", "−1 pt", "0 pts". */
function pts(n: number, unit: string, sign = true) {
  const v = Math.round(n * 10) / 10;
  const abs = Math.abs(v);
  const u = unit === "%" ? (abs === 1 ? " pt" : " pts") : unit ? ` ${unit}` : "";
  return `${sign ? v > 0 ? "+" : v < 0 ? "−" : "" : ""}${abs}${u}`;
}
const bare = (n: number) => pts(n, "");
const noise = (n: number | null, unit: string) => n === null ? "no noise estimate" : `noise ±${pts(n, unit, false)}`;

const LEAD: Record<"best" | "base", Record<Standing, string>> = {
  best: { above: "Beats its best patch alone", level: "Same as its best patch alone", below: "Worse than its best patch alone" },
  base: { above: "Better than base", level: "No clear change", below: "Worse than base" },
};
const leadLabel = (s: Combo) => LEAD[s.reading.lead.against][s.reading.lead.standing];
const leadShort = (s: Combo) => `${pts(s.reading.sign * s.reading.lead.gap, s.unit)} vs ${s.reading.lead.against === "best" ? "best alone" : "base"}`;

function readout(s: Combo) {
  const r = s.reading;
  const u = s.unit;
  if (r.lead.against === "base") return [{ label: "vs base", value: `${pts(r.together, u)} · ${noise(r.lead.noise, u)}`, note: "" }];
  const best = s.members[r.lead.member!];
  const rows = [{ label: `vs ${nameOf(best.release)} alone`, value: `${bare(r.together)} vs ${bare(r.lead.ref)} → ${pts(r.together - r.lead.ref, u)} · ${noise(r.lead.noise, u)}`, note: "" }];
  if (r.sum) rows.push({ label: "vs the sum alone", value: `${r.alone!.map(bare).join(" ")} = ${bare(r.sum.ref)} → ${pts(r.together - r.sum.ref, u)} · ${noise(r.sum.noise, u)}`, note: SUM_LABEL[r.sum.verdict] });
  return rows;
}

function sentence(s: Combo) {
  const r = s.reading;
  const u = s.unit;
  const lead = `Together the stack moves the score ${pts(r.together, u)} from the base (${fmt(s.baseline, u)} → ${fmt(s.together, u)}).`;
  if (r.lead.against === "base") return `${lead} No solo scores were filed, so it can only be compared with the base: ${leadLabel(s).toLowerCase()} (${noise(r.lead.noise, u)}).`;
  const best = nameOf(s.members[r.lead.member!].release);
  const parts = [`${lead} The best patch alone, ${best}, moves it ${pts(r.lead.ref, u)}, so the stack is ${leadLabel(s).toLowerCase().replace("its best patch alone", "that patch alone")} (${noise(r.lead.noise, u)}).`];
  if (r.sum) parts.push(`Added up, the solo changes predict ${pts(r.sum.ref, u)}; the stack lands ${pts(r.together - r.sum.ref, u)} from that (${noise(r.sum.noise, u)}), read as "${SUM_LABEL[r.sum.verdict]}".`);
  return parts.join(" ");
}

function chart(s: Combo) {
  const r = s.reading;
  const x = (d: number) => r.sign * d;
  const ref = x(r.sum?.ref ?? 0);
  const bandNoise = r.sum ? r.sum.noise : r.lead.noise;
  const values = [...(r.alone ?? []).map(x), x(r.together), ref + (bandNoise ?? 0), ref - (bandNoise ?? 0)];
  const half = Math.max(...values.map(Math.abs), 1) * 1.12;
  const pos = (v: number) => 50 + 50 * v / half;
  const bar = (v: number) => `left:${Math.min(50, pos(v))}%;width:${Math.abs(pos(v) - 50)}%`;
  const rows = [
    ...s.members.map((m, k) => r.alone ? { kind: k === r.lead.member ? "alone top" : "alone", label: `${nameOf(m.release)} alone`, href: m.release.isLatest ? m.release.patch.url : m.release.url, d: r.alone[k] } : null),
    r.sum ? { kind: "expected", label: "Solo changes added up", d: r.sum.ref } : null,
    { kind: `together ${r.lead.standing}`, label: "Together", d: r.together },
  ].filter(row => row !== null);
  const band = bandNoise === null ? null : `left:${pos(ref - bandNoise)}%;width:${pos(ref + bandNoise) - pos(ref - bandNoise)}%`;
  const key = [r.sum && "Dashed: the solo changes added up.", bandNoise !== null && `Shaded: ±${pts(bandNoise, s.unit, false)} noise around ${r.sum ? "that sum" : "the base"}.`].filter(Boolean).join(" ");
  return { rows: rows.map(row => ({ ...row, style: bar(x(row.d)) })), band, key };
}

const cards = live.map(s => ({ s, c: chart(s), lines: readout(s) }));
---
<div class="combos" data-combos>
  <p class="combo-intro">Any patches can be applied together. These are the stacks someone benchmarked, each compared with its best patch alone.</p>

  {!version && releases.length > 1 && <div class="stack-pick" role="group" aria-label="Pick patches to stack">
    <span class="stack-pick-label">Stack</span>
    {releases.map(v => <button type="button" class="stack-chip" data-slug={v.patch.slug} data-name={nameOf(v)} aria-pressed="false">{nameOf(v)}</button>)}
    <button type="button" class="stack-clear" data-clear hidden>Clear</button>
  </div>}

  {!all.length && <p class="quiet-row">{releases.length < 2 && !version
    ? "This model has one active patch, so there is nothing to stack yet."
    : <>No one has reported a stack {version ? "with this release" : "for these patches"} yet. <a href={submit}>Benchmark one and submit it</a>.</>}</p>}

  {all.length > 0 && <div class:list={["combo-layout", { single: !!version }]}>
    {!version && <div class="stack-list">
      <h3>Measured stacks <span>({live.length})</span></h3>
      <ul>{live.map(s => <li><button type="button" data-pick={s.key}>
        <span class="sl-name">{s.members.map(m => nameOf(m.release)).join(" + ")}</span>
        <span class:list={["sl-gap", s.reading.lead.standing]}>{leadShort(s)}</span>
        <small>{s.benchmark} · {s.denominator} items · {sourceLabels[s.measured_by]}</small>
      </button></li>)}</ul>
      <p class="sl-hint">Pick patches above to check any other stack.</p>
    </div>}

    <div class="combo-details">
      {!version && <p class="combo-status" data-status role="status">All reported stacks ({live.length})</p>}
      <p class="combo-empty" data-empty hidden>No one has reported this exact stack yet. <a href={submit}>Benchmark it and submit the result</a>.</p>
      {cards.map(({ s, c, lines }) => <article class="combo-card" data-stack={s.key}>
        <span class="combo-inside">Inside this stack</span>
        <div class="combo-head">
          <div>
            <p class="studymeta"><span class:list={["src-chip", s.measured_by === "author" ? "self" : "indep"]}>{sourceLabels[s.measured_by]}</span> · {s.benchmark} · {s.metric} · {s.denominator} items</p>
            <h3>{s.members.map((m, k) => <>{k > 0 && <span class="plus"> + </span>}{nameOf(m.release)} {m.release.label}</>)}</h3>
          </div>
          <span class:list={["verdict", s.reading.lead.standing]}>{leadLabel(s)}</span>
        </div>
        <dl class="combo-readout">
          {lines.map(l => <div><dt>{l.label}</dt><dd><span>{l.value}</span>{l.note && <b>{l.note}</b>}</dd></div>)}
        </dl>
        <div class="cv-chart" role="group" aria-label={`Changes from the base: ${c.rows.map(r => `${r.label} ${pts(r.d, s.unit)}`).join(", ")}`}>
          {c.rows.map(r => <div class:list={["cv-row", r.kind]}>
            <span class="cv-label">{"href" in r && r.href ? <a href={r.href}>{r.label}</a> : r.label}</span>
            <span class="cv-track" aria-hidden="true">
              {r.kind.startsWith("together") && c.band && <span class="cv-band" style={c.band}></span>}
              <i style={r.style}></i>
            </span>
            <span class="cv-val">{pts(r.d, s.unit)}</span>
          </div>)}
          <div class="cv-axis" aria-hidden="true"><span>worse</span><span>base {fmt(s.baseline, s.unit)}</span><span>better</span></div>
          {c.key && <p class="cv-key">{c.key}</p>}
        </div>
        <details class="fold"><summary>How this was measured</summary>
          <p>{sentence(s)}</p>
          <p>{s.protocol}</p>
          <ul>{s.members.map(m => <li>{nameOf(m.release)} {m.release.label} · {m.artifact.name} · scale {m.scale}</li>)}</ul>
          {s.reading.lead.noise !== null && <p>Noise ranges are approximate 95% ranges for {s.denominator} items, treating each score as an independent sample. Scoring every treatment on the same items usually makes the real range narrower.</p>}
          <a href={index.docsAt(s.file)}>Measurement record</a>
        </details>
      </article>)}
      {earlier.length > 0 && <details class="fold combo-earlier"><summary>Reports for earlier versions ({earlier.length})</summary>
        {earlier.map(s => <p>{s.members.map(m => `${nameOf(m.release)} ${m.release.label}`).join(" + ")} · {s.benchmark} · <span class:list={["verdict", s.reading.lead.standing]}>{leadLabel(s)}</span> · <a href={index.docsAt(s.file)}>record</a></p>)}
      </details>}
    </div>
  </div>}
  {untested.length > 0 && <p class="untested-list">Not measured with {untested.map((v, i) => <>{i > 0 && ", "}<a href={v.patch.url}>{nameOf(v)}</a></>)} yet. <a href={submit}>Submit a stack benchmark</a>.</p>}
</div>
<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-combos]")) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-slug]")];
    if (!chips.length) continue;
    const picks = [...root.querySelectorAll<HTMLButtonElement>("[data-pick]")];
    const cards = [...root.querySelectorAll<HTMLElement>("[data-stack]")];
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const empty = root.querySelector<HTMLElement>("[data-empty]")!;
    const clear = root.querySelector<HTMLButtonElement>("[data-clear]")!;
    const names = new Map(chips.map(c => [c.dataset.slug!, c.dataset.name!]));
    const keyOf = (slugs: Iterable<string>) => [...slugs].sort().join("|");
    let picked = new Set<string>();
    const render = () => {
      const key = keyOf(picked);
      chips.forEach(c => c.setAttribute("aria-pressed", String(picked.has(c.dataset.slug!))));
      picks.forEach(b => b.setAttribute("aria-pressed", String(picked.size > 1 && b.dataset.pick === key)));
      clear.hidden = !picked.size;
      let exact = 0, inside = 0;
      for (const card of cards) {
        const members = card.dataset.stack!.split("|");
        const match = card.dataset.stack === key;
        const show = picked.size === 0 || (picked.size === 1 ? members.some(m => picked.has(m)) : members.every(m => picked.has(m)));
        card.hidden = !show;
        card.classList.toggle("inside", show && picked.size > 1 && !match);
        card.style.order = match ? "0" : "2";
        if (show && match) exact++;
        else if (show) inside++;
      }
      const list = [...picked].map(s => names.get(s)).join(" + ");
      status.textContent = picked.size === 0 ? `All reported stacks (${cards.length})`
        : picked.size === 1 ? `Stacks that include ${list} (${inside + exact})`
        : `${list}: ${exact ? `${exact} report${exact > 1 ? "s" : ""}` : "not measured yet"}${inside ? ` · ${inside} for smaller stacks inside it` : ""}`;
      empty.hidden = picked.size < 2 || exact > 0;
    };
    const reveal = () => { if (matchMedia("(max-width: 62rem)").matches) status.scrollIntoView({ block: "nearest", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" }); };
    chips.forEach(c => c.addEventListener("click", () => {
      const slug = c.dataset.slug!;
      picked.has(slug) ? picked.delete(slug) : picked.add(slug);
      render();
    }));
    picks.forEach(b => b.addEventListener("click", () => {
      picked = b.getAttribute("aria-pressed") === "true" ? new Set() : new Set(b.dataset.pick!.split("|"));
      render();
      reveal();
    }));
    clear.addEventListener("click", () => { picked = new Set(); render(); });
    render();
  }
</script>
