---
// Home-page proof card: a real release's edited columns drawn on its weight
// matrices, and its recorded results, switchable between the unpatched base and
// the patched model. Static HTML shows the patched state. It flips on its own
// while in view, pauses under the pointer or keyboard focus, and stops for good
// once the reader picks a state. The moving numbers are hidden from assistive
// tech, which reads the static base/patched pair instead.
import type { Version } from "../../lib/types.ts";
import { authorReport } from "../../data/reports.ts";
import { editStats, editDeltas, strength, results, compact, percent, fmt, SOURCE_NOTE } from "../../lib/insight.ts";
import { weight } from "../../lib/heat.ts";
import { humanBytes } from "../../lib/format.ts";
interface Props { version: Version }
const { version: v } = Astro.props;
const stats = editStats(v);
const all = results(v);
const shown = (all.some(r => r.source !== "author") ? all.filter(r => r.source !== "author") : all).slice(0, 3);
const source = shown[0]?.source;
const name = authorReport(v)?.name ?? v.patch.title;
const ROWS = 10, COLS = 56;
const clamp = (x: number) => Math.min(1, Math.max(0, x)).toFixed(3);
const deltas = editDeltas(v, ROWS);
const size = stats?.replacementBytes ?? v.files.find(f => f.role === "source")?.size_bytes;
---
<figure class="flip" data-flip data-state="patched">
  <div class="flip-head">
    <div><a class="flip-title" href={v.patch.url}>{name}</a><span class="flip-model">{v.patch.base.address}</span></div>
    <div class="flip-switch" data-slide="thumb" role="group" aria-label="Show model state">
      <button type="button" data-set="base" aria-pressed="false">Base</button>
      <button type="button" data-set="patched" aria-pressed="true">Patched</button>
    </div>
  </div>
  {stats && <div class="flip-mats">
    {stats.tensors.slice(0, 2).map((t, ti) => <div class="flip-mat">
      <div class="flip-mat-label"><span>{t.short.replace(/^layers\.(\d+)\./, "layer $1 · ")}</span><span>{t.active} / {t.cols.toLocaleString("en-US")} cols</span></div>
      <div class="flip-layers" role="img" aria-label={`Weight matrix ${t.short}: ${t.active} of ${t.cols} input columns edited, highlighted when patched.`}>
        <svg class="flip-base" viewBox={`0 0 ${COLS * 5} ${ROWS * 5}`} preserveAspectRatio="none" aria-hidden="true">
          {Array.from({ length: ROWS }, (_, i) => Array.from({ length: COLS }, (_, j) =>
            <rect x={j * 5} y={i * 5} width="4.2" height="4.2" rx=".6" opacity={(0.12 + 0.6 * weight(i, j, ti)).toFixed(2)} />))}
        </svg>
        <svg class="flip-hot" viewBox={`0 0 ${COLS * 5} ${ROWS * 5}`} preserveAspectRatio="none" aria-hidden="true">
          {(deltas[ti]?.columns ?? t.columns).map((c, k) => Array.from({ length: ROWS }, (_, i) => {
            const d = deltas[ti]?.cells[i]?.[k];
            const x = (c / t.cols) * COLS * 5;
            return d === null ? null : <rect x={x} y={i * 5} width="1.7" height="4.2" opacity={d === undefined ? 0.9 : (0.2 + 0.8 * strength(d, deltas[ti].scale)).toFixed(2)} />;
          }))}
        </svg>
      </div>
    </div>)}
  </div>}
  {shown.length > 0 && <div class="flip-scores">
    {source && <p class="flip-src"><span class:list={["src-chip", source === "author" ? "self" : "indep"]}>{SOURCE_NOTE[source]}</span></p>}
    {shown.map(r => <div class="flip-score" data-base={r.base} data-patched={r.patched} style={`--b:${clamp(r.base / 100)};--p:${clamp(r.patched / 100)}`}>
      <div class="flip-score-head"><span>{r.benchmark}{r.metric && <small> {r.metric}</small>}</span>
        <span class="flip-num" aria-hidden="true">{fmt(r.patched, r.unit)}</span>
        <span class="visually-hidden">{fmt(r.base, r.unit)} base, {fmt(r.patched, r.unit)} patched</span></div>
      <div class="flip-bar"><i></i></div>
    </div>)}
  </div>}
  <figcaption class="flip-foot">
    {size && <span><b>{humanBytes(size)}</b> patch</span>}
    {stats?.modelParams && <span><b>{percent(stats.elements, stats.modelParams)}</b> of {compact(stats.modelParams)} weights changed</span>}
  </figcaption>
</figure>
<script>
  for (const fig of document.querySelectorAll<HTMLElement>("[data-flip]")) {
    const buttons = [...fig.querySelectorAll<HTMLButtonElement>("[data-set]")];
    const scores = [...fig.querySelectorAll<HTMLElement>(".flip-score")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let raf = 0;
    const set = (state: "base" | "patched") => {
      fig.dataset.state = state;
      buttons.forEach(b => b.setAttribute("aria-pressed", String(b.dataset.set === state)));
      cancelAnimationFrame(raf);
      const t0 = performance.now();
      const nums = scores.map(s => s.querySelector<HTMLElement>(".flip-num")!);
      const from = nums.map(n => parseFloat(n.textContent!));
      const step = (t: number) => {
        const k = reduce ? 1 : Math.min(1, (t - t0) / 650);
        const e = 1 - (1 - k) ** 3;
        scores.forEach((s, i) => {
          const to = parseFloat(s.dataset[state]!);
          nums[i].textContent = `${(from[i] + (to - from[i]) * e).toFixed(1)}%`;
        });
        if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    let user = false;
    buttons.forEach(b => b.addEventListener("click", () => { user = true; set(b.dataset.set as "base" | "patched"); }));
    if (!reduce) {
      let visible = false;
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(fig);
      set("base");
      const tick = (next: "base" | "patched", wait: number) => setTimeout(() => {
        if (user) return;
        if (!visible || fig.matches(":hover, :focus-within")) return tick(next, 600);
        set(next);
        tick(next === "base" ? "patched" : "base", next === "base" ? 1800 : 3600);
      }, wait);
      tick("patched", 1100);
    }
  }
</script>
