---
import Arrow from "../Arrow.astro";
import { activeVersion, formats, discoveryText } from "../../lib/catalog.ts";
import { plural } from "../../lib/format.ts";
import { directoryBenchmarkHighlight, gain } from "../../lib/insight.ts";
import { versionTerms } from "../../lib/search.ts";
import type { Base, Version } from "../../lib/types.ts";

interface Props { base: Base }
const { base } = Astro.props;
const releases = base.patches.map(activeVersion).filter((v): v is Version => !!v);
const availableFormats = [...new Set(releases.flatMap(formats))];
const names = releases.map(v => v.patch.title);
const terms = [discoveryText(base.address, base.patches, availableFormats),
  ...names, ...releases.map(versionTerms)].join(" ").toLowerCase();
const highlight = directoryBenchmarkHighlight(releases);
const highlightDelta = highlight ? (() => {
  const v = Math.round(gain(highlight) * 10) / 10;
  const sign = v > 0 ? "+" : v < 0 ? "−" : "±";
  const unit = highlight.unit === "%" ? "%" : highlight.unit ? ` ${highlight.unit}` : "";
  return `${sign}${Math.abs(v)}${unit}`;
})() : null;
---
<li data-search={terms}>
  <a class="model-entry" href={base.url}>
    <span class="model-entry__main">
      <strong>{base.model}</strong>
      <small>
        {base.ns} · {plural(releases.length, "active patch", "active patches")}
        {availableFormats.length > 0 && ` · ${availableFormats.join(" + ")}`}
        {base.dir.startsWith("docs/example/") && " · Synthetic example"}
      </small>
    </span>
    <span class="model-entry__right">
      {highlight && highlightDelta && (
        <span class="model-entry__bench">
          <span class="model-entry__bench-name">{highlight.benchmark}</span>
          <span class="model-entry__bench-delta">{highlightDelta}</span>
        </span>
      )}
      <span class="entry-arrow"><Arrow /></span>
    </span>
  </a>
</li>
