            },
            "comparisons": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reference"
              },
              "minItems": 0
            },
            "quality": {
              "const": "UNKNOWN"
            }
          },
          "required": [
            "id",
            "profile_ref",
            "treatment_ref",
            "intended_use",
            "reason",
            "policy",
            "comparisons",
            "quality"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$(?![\\s\\S])"
            },
            "profile_ref": {
              "$ref": "#/$defs/reference"
            },
            "treatment_ref": {
              "$ref": "#/$defs/reference"
            },
            "intended_use": {
              "$ref": "#/$defs/context"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "policy": {
              "$ref": "#/$defs/artifact"
            },
            "comparisons": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reference"
              },
              "minItems": 1
            },
            "quality": {
              "enum": [
