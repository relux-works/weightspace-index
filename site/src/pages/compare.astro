---
// Every benchmark group of every base, one table each. A group is one profile,
// protocol, dataset and settings; runs are never compared across groups.
import Page from "../layouts/Page.astro";
import Badge from "../components/Badge.astro";
import Hash from "../components/Hash.astro";
import Score from "../components/Score.astro";
import { href, loadIndex, measuredBy, type Run } from "../lib/index.ts";
import { BUCKET_LABEL, barLabel } from "../lib/rank.ts";
import { plural } from "../lib/format.ts";

const index = loadIndex();
const order = (a: Run, b: Run) =>
  (a.version ? 1 : 0) - (b.version ? 1 : 0) || barLabel(a).localeCompare(barLabel(b)) || a.id.localeCompare(b.id);
---
<Page title="Compare" nav="compare" description="Benchmark runs side by side, one table per profile, protocol, dataset and settings.">
  <header class="page-head">
    <h1>Compare</h1>
    <p class="lede">
      One table per base, profile, protocol, dataset and settings. Runs in different tables are not comparable and are never ranked together.
      Scores are as recorded; the index computes no differences or intervals here.
    </p>
  </header>

  {index.bases.every((b) => b.groups.length === 0) ? (
    <p class="empty"><strong>No benchmarks submitted</strong> to the index yet.</p>
  ) : (
    index.bases.filter((b) => b.groups.length > 0).map((base) => (
      <section class="section">
        <header><h2><a href={base.url}>{base.address}</a></h2></header>
        <div class="stack">
          {base.groups.map((g) => (
            <article class="card" id={g.id}>
              <div class="card-head">
                <h3 class="grow">{g.protocolLabel} <span class="muted" style="font-weight:400">· {g.settingsLabel}</span></h3>
                <span class="tag">{g.profile.id}</span>
              </div>
              <dl class="facts small" style="margin-bottom:12px">
                <div><dt>Protocol</dt><dd><span class="mono">{g.protocol.name}</span> <Hash value={g.protocol.sha256} n={12} /></dd></div>
                <div><dt>Dataset</dt><dd><span class="mono">{g.dataset.name}</span> <Hash value={g.dataset.sha256} n={12} /></dd></div>
              </dl>
              <div class="table-wrap">
                <table class="compact">
                  <thead>
                    <tr><th>Treatment</th><th>Run</th><th>Measured by</th><th>State</th><th>Score</th><th>Paired with</th></tr>
                  </thead>
                  <tbody>
                    {[...g.runs].sort(order).map((r) => (
                      <tr>
                        <td>{r.version ? <a href={r.version.url}>{barLabel(r)}</a> : "unpatched base"}</td>
                        <td><a href={r.url} class="mono small">{r.id}</a></td>
                        <td title={BUCKET_LABEL[measuredBy(r)]}>{r.record.performed_by}</td>
                        <td><Badge state={r.record.state} /></td>
                        <td><Score score={r.record.score} compact /></td>
                        <td>{r.paired ? <a href={r.paired.url} class="small">{barLabel(r.paired)}</a> : <span class="muted small">none</span>}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="small muted" style="margin:10px 0 0">{plural(g.runs.length, "run")}. Index-measured and reported results stay in separate rankings on the <a href={`${base.url}#${g.id}`}>base page</a>.</p>
            </article>
          ))}
        </div>
      </section>
    ))
  )}
</Page>
