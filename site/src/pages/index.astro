---
import Page from "../layouts/Page.astro";
import ModelCard from "../components/catalog/ModelCard.astro";
import Footprint from "../components/catalog/Footprint.astro";
import Filter from "../components/catalog/Filter.astro";
import { loadIndex } from "../lib/index.ts";
import { activeVersion, footprint } from "../lib/catalog.ts";
import { plural } from "../lib/format.ts";
const index = loadIndex();
const models = index.bases;
const featured = models.flatMap(b => b.patches.map(activeVersion)).find(v => v && footprint(v));
---
<Page title="Weightspace Index" nav="models" description="Find a patch for your model. Compare author reports and independent benchmarks, then download the replacement or LoRA.">
  <div class="wrap catalog-home">
    <div class:list={["discovery-hero", { "with-figure": featured }]}>
      <div class="hero-copy">
        <h1>Find patches <em>for your model.</em></h1>
        <p>Explore weight edits for open models. See what changed, compare the evidence, and download a replacement or LoRA.</p>
        <a class="browse-link" href="#models">Browse models <span aria-hidden="true">↓</span></a>
      </div>
      {featured && <Footprint version={featured} />}
    </div>
    <section id="models" class="directory">
      <div class="directory-head">
        <div><h2>Model directory</h2><p>{plural(models.length, "model")} · {plural(models.reduce((n, b) => n + b.patches.length, 0), "patch", "patches")}</p></div>
        {models.length > 0 && <Filter target="model-list" label="Filter by model, patch or author" noun="models" />}
      </div>
      <p class="filter-status" role="status" id="model-list-status"></p>
      <div class="model-grid" id="model-list">{models.map(base => <ModelCard base={base} />)}</div>
      {models.length === 0 && <p class="quiet-row">The catalog is ready for its first model.</p>}
    </section>
  </div>
</Page>
