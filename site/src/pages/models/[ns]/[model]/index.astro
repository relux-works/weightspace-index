---
import Page from "../../../../layouts/Page.astro";
import Badge from "../../../../components/Badge.astro";
import Command from "../../../../components/Command.astro";
import FileList from "../../../../components/FileList.astro";
import GroupResults from "../../../../components/GroupResults.astro";
import Head from "../../../../components/Head.astro";
import Score from "../../../../components/Score.astro";
import Section from "../../../../components/Section.astro";
import { href, loadIndex, profileFiles, type Base } from "../../../../lib/index.ts";
import { hfDownload, profileDir, verify } from "../../../../lib/commands.ts";

export function getStaticPaths() {
  return loadIndex().bases.map((base) => ({ params: { ns: base.ns, model: base.model }, props: { base } }));
}
interface Props { base: Base }
const { base } = Astro.props;
---
<Page
  title={base.address}
  description={`Weight patches for ${base.address}: files, versions and recorded benchmark results.`}
  nav="models"
>
  <Head crumbs={[{ label: "Models", href: href() }, { label: base.address }]} eyebrow="Base model">
    <h1 class="break">{base.address}</h1>
    <dl class="facts">
      <div><dt>Patches</dt><dd>{base.patches.length}</dd></div>
      <div><dt>Profiles</dt><dd><span class="row">{base.profiles.map((p) => <a class="tag" href={`#profile-${p.id}`}>{p.id}</a>)}</span></dd></div>
      <div><dt>Benchmark runs</dt><dd>{base.runs.length === 0 ? <span class="muted">no benchmarks submitted</span> : base.runs.length}</dd></div>
      <div><dt>Benchmark groups</dt><dd>{base.groups.length}</dd></div>
    </dl>
    <nav class="toc" aria-label="On this page">
      <a href="#patches">Patches</a>
      <a href="#results">Results</a>
      <a href="#combinations">Combinations</a>
      <a href="#profiles">Profiles</a>
      <a href="#records">Records</a>
    </nav>
  </Head>

  <Section title="Patches" id="patches">
    {base.patches.length === 0 ? (
      <p class="empty"><strong>No patches for this base yet.</strong></p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead><tr><th>Patch</th><th>Kind</th><th>Latest</th><th>License</th><th>Evidence (latest)</th></tr></thead>
          <tbody>
            {base.patches.map((p) => {
              const latest = p.versions.find((v) => v.n === p.latest) ?? null;
              return (
                <tr>
                  <td>
                    <a class="title" href={p.url}>{p.title}</a>
                    <span class="sub">{p.summary}</span>
                    {p.tags.length > 0 && <div class="row" style="margin-top: var(--space-2)">{p.tags.map((t) => <a class="tag" href={href(`search/?tag=${encodeURIComponent(t)}`)}>{t}</a>)}</div>}
                  </td>
                  <td>{p.kind}</td>
                  <td class="nowrap">
                    {latest ? <a href={latest.url}>{latest.label}</a> : <span class="muted">no active version</span>}
                  </td>
                  <td class="nowrap">{p.license}</td>
                  <td>
                    {latest ? (
                      <span class="row">{latest.evidence.map((e) => <Badge state={e} />)}</span>
                    ) : (
                      <span class="muted">none</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </Section>

  <Section title="Results" id="results" subtle>
    <Fragment slot="intro">
      Grouped by profile, protocol, dataset and settings. Each group is ranked on its own, and index-measured results are kept apart from reported ones. Scores are shown as recorded.
    </Fragment>
    {base.groups.length === 0 ? (
      <p class="empty"><strong>No benchmarks submitted</strong>No run records exist for this base.</p>
    ) : (
      <div class="cards">{base.groups.map((g) => <GroupResults group={g} />)}</div>
    )}
  </Section>

  <Section title="Measured combinations" id="combinations">
    <Fragment slot="intro">Combinations are ranked only when a run measured them, never estimated from single patches.</Fragment>
    <p class="empty">
      <strong>No measured combinations</strong>Every run in the index measures the unpatched base or a single patch version.
    </p>
  </Section>

  <Section title="Profiles" id="profiles">
    <Fragment slot="intro">The exact base files each patch version targets. Download at the pinned revision and check every file before applying anything.</Fragment>
    <div class="subsections">
      {base.profiles.map((profile) => {
        const baseline = base.baselineRuns.filter((r) => r.record.profile === profile.id);
        return (
          <article class="subsection" id={`profile-${profile.id}`}>
            <div class="subsection-head">
              <h3>Profile <span class="mono">{profile.id}</span></h3>
              <a class="small" href={`https://huggingface.co/${profile.source.repo_id}/tree/${profile.source.revision}`} rel="noopener noreferrer">
                <span class="mono">{profile.source.repo_id}@{profile.source.revision.slice(0, 7)}</span>
              </a>
            </div>
            <FileList files={profileFiles(profile)} showRole={false} />
            <div class="cmds">
              <Command title="Download the profile" command={hfDownload(base, profile)} />
              {profile.files.map((f) => (
                <Command title={`Check ${f.path}`} command={verify(`${profileDir(base, profile)}/${f.path}`)} />
              ))}
            </div>
            {baseline.length > 0 && (
              <div class="stack">
                <p class="eyebrow">Baseline runs on this profile</p>
                <div class="table-wrap">
                  <table class="compact">
                    <thead><tr><th>Run</th><th>Protocol · settings</th><th>Measured by</th><th>State</th><th>Score</th></tr></thead>
                    <tbody>
                      {baseline.map((r) => (
                        <tr>
                          <td><a href={r.url} class="mono small">{r.id}</a></td>
                          <td>{r.protocolLabel} · {r.settingsLabel}</td>
                          <td>{r.record.performed_by}</td>
                          <td><Badge state={r.record.state} /></td>
                          <td><Score score={r.record.score} compact /></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </article>
        );
      })}
    </div>
  </Section>

  <Section title="Records" id="records">
    <Fragment slot="intro">The base record this page is built from.</Fragment>
    <FileList files={[base.baseRecord]} showRole={false} />
  </Section>
</Page>
