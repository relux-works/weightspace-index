---
import type { Version } from "../../lib/types.ts";
import { downloadUrl } from "../../lib/catalog.ts";
import { runtimeGuide } from "../../lib/runtime.ts";
import { humanBytes } from "../../lib/format.ts";
interface Props { version: Version; compact?: boolean }
const { version: v, compact = false } = Astro.props;
const guide = runtimeGuide(v);
const lora = guide.download;
const sources = v.patch.kind === "replacement" ? v.files.filter(f => f.role === "source") : [];
const items = [
  ...(lora ? [{ label: "LoRA adapter", hint: guide.tabs.length ? `Load at runtime · ${lora.label}` : lora.label, href: lora.href, filename: lora.name, size: lora.sizeBytes, tab: "lora" }] : []),
  ...sources.map(f => ({ label: sources.length === 1 ? "Direct replacement" : f.name, hint: "Bake into a model copy", href: downloadUrl(f), filename: f.name, size: f.size_bytes, tab: "weightspace" })),
];
---
<div class:list={["file-choices", { compact }]}>
  {items.map(file => <a href={file.href} download={file.filename} data-tab-select={compact ? undefined : file.tab} aria-label={`Download ${file.label} · ${humanBytes(file.size)}`}>
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 2v8.5M4.5 7 8 10.5 11.5 7M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span><strong>{file.label}</strong>{!compact && <small>{file.hint}</small>}</span>
    {!compact && <span class="file-size">{humanBytes(file.size)}</span>}
  </a>)}
  {!items.length && <a href={`${v.isLatest ? v.patch.url : v.url}#records`}>Browse release files</a>}
</div>
